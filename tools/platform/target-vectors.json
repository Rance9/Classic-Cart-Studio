{
  "schema": "ccs-target-vectors/1",
  "about": "Shared decisions every reader of ccs-platform-registry.json must make the same way (C#: CcsBackup.Compose.Capabilities, Python: tools/companion/platform_ids.py, JavaScript: tools/rom-pipeline/studio/platform-ids.js). Each vector is a document (with the entries it lists) or a worker request, and the expected decision code. GPL-3.0-or-later.",
  "vectors": [
    {"name": "a collection written before ccs_target existed is NES", "doc_kind": "collection", "doc": {"schema": "nes-classic-collection/4", "selections": [{"version_id": "0123456789abcdef"}]}, "entries": "selections", "expect": "ok", "legacy": true, "target": {"game_system": "nes", "core": "fceumm"}},
    {"name": "an explicit NES target", "doc_kind": "collection", "doc": {"schema": "nes-classic-collection/4", "ccs_target": {"schema": "ccs-target/1", "game_system": "nes", "core": "fceumm"}}, "expect": "ok", "legacy": false, "target": {"game_system": "nes", "core": "fceumm"}},
    {"name": "a collection that claims the reserved SNES game system", "doc_kind": "collection", "doc": {"schema": "nes-classic-collection/4", "ccs_target": {"schema": "ccs-target/1", "game_system": "snes"}}, "expect": "reserved"},
    {"name": "a package that names the reserved SNES core", "doc_kind": "ccs-package", "doc": {"schema": "ccs-package/2", "ccs_target": {"schema": "ccs-target/1", "core": "snes-unselected"}}, "expect": "reserved"},
    {"name": "a package that names a core no registry knows", "doc_kind": "ccs-package", "doc": {"schema": "ccs-package/2", "ccs_target": {"schema": "ccs-target/1", "game_system": "nes", "core": "snes9x"}}, "expect": "unknown-id"},
    {"name": "a newer target schema", "doc_kind": "collection", "doc": {"ccs_target": {"schema": "ccs-target/2", "game_system": "nes"}}, "expect": "target-schema"},
    {"name": "a target without a schema", "doc_kind": "collection", "doc": {"ccs_target": {"game_system": "nes"}}, "expect": "target-schema"},
    {"name": "a target that tries to add a capability field", "doc_kind": "collection", "doc": {"ccs_target": {"schema": "ccs-target/1", "game_system": "nes", "capabilities": ["snes-gameplay"]}}, "expect": "unknown-field"},
    {"name": "a target whose prototype key is a field name", "doc_kind": "collection", "doc": {"ccs_target": {"schema": "ccs-target/1", "__proto__": {"game_system": "snes"}}}, "expect": "unknown-field"},
    {"name": "an identifier that is an inherited property name", "doc_kind": "collection", "doc": {"ccs_target": {"schema": "ccs-target/1", "game_system": "constructor"}}, "expect": "unknown-id"},
    {"name": "a target that is not an object", "doc_kind": "collection", "doc": {"ccs_target": "snes"}, "expect": "damaged"},
    {"name": "a target field that is not a name", "doc_kind": "collection", "doc": {"ccs_target": {"schema": "ccs-target/1", "core": null}}, "expect": "damaged"},
    {"name": "a game saves file that claims SNES", "doc_kind": "game-saves", "doc": {"schema": "ccs-game-saves/1", "platform": "web-wasm32", "ccs_target": {"schema": "ccs-target/1", "game_system": "snes"}}, "expect": "reserved"},
    {"name": "a game saves file whose game entry claims SNES", "doc_kind": "game-saves", "doc": {"schema": "ccs-game-saves/1", "platform": "web-wasm32", "games": [{"content_sha256": "aa", "game_system": "snes"}]}, "entries": "games", "expect": "reserved"},
    {"name": "a game entry that names NES", "doc_kind": "game-saves", "doc": {"schema": "ccs-game-saves/1", "games": [{"content_sha256": "aa", "game_system": "nes"}]}, "entries": "games", "expect": "ok", "legacy": true},
    {"name": "a game entry whose system is not a name", "doc_kind": "collection", "doc": {"selections": [{"version_id": "0123456789abcdef", "game_system": 3}]}, "entries": "selections", "expect": "damaged"},
    {"name": "a console package for the reserved SNES boot option's system", "doc_kind": "console-package", "doc": {"schema": "ccs-console-package/1", "ccs_target": {"schema": "ccs-target/1", "game_system": "snes", "method": "ccs-home-autostart"}}, "expect": "reserved"},
    {"name": "a console package written before ccs_target existed", "doc_kind": "console-package", "doc": {"schema": "ccs-console-package/1"}, "expect": "ok", "legacy": true, "target": {"game_system": "nes", "core": "fceumm", "physical_model": "nes-classic-edition", "method": "ccs-home-autostart"}},
    {"name": "a console backup written before ccs_target existed", "doc_kind": "console-backup", "doc": {"schema": "ccs-console-backup/1"}, "expect": "ok", "legacy": true, "target": {"physical_model": "nes-classic-edition", "firmware": "nintendo-nes-classic", "layout": "nes-classic-nand-512m"}},
    {"name": "a console backup that names the SNES Classic model but not its software and layout (the NES defaults do not fit it)", "doc_kind": "console-backup", "doc": {"schema": "ccs-console-backup/1", "ccs_target": {"schema": "ccs-target/1", "physical_model": "snes-classic-edition"}}, "expect": "inconsistent"},
    {"name": "a Super NES Classic backup with its model, software and layout", "doc_kind": "console-backup", "doc": {"schema": "ccs-console-backup/1", "ccs_target": {"schema": "ccs-target/1", "physical_model": "snes-classic-edition", "firmware": "nintendo-snes-classic", "layout": "snes-classic-nand-512m"}}, "expect": "ok"},
    {"name": "a Super NES Classic backup that names the NES Classic's layout", "doc_kind": "console-backup", "doc": {"ccs_target": {"schema": "ccs-target/1", "physical_model": "snes-classic-edition", "firmware": "nintendo-snes-classic", "layout": "nes-classic-nand-512m"}}, "expect": "inconsistent"},
    {"name": "the Super NES Classic hardware does not make its game system playable", "doc_kind": "console-package", "doc": {"ccs_target": {"schema": "ccs-target/1", "physical_model": "snes-classic-edition", "game_system": "snes"}}, "expect": "reserved"},
    {"name": "Nintendo's SNES software named on NES hardware is not a core", "doc_kind": "console-backup", "doc": {"ccs_target": {"schema": "ccs-target/1", "physical_model": "nes-classic-edition", "firmware": "nintendo-snes-classic"}}, "expect": "inconsistent"},
    {"name": "an unproven SNES storage layout", "doc_kind": "console-backup", "doc": {"ccs_target": {"schema": "ccs-target/1", "layout": "snes-classic-unproven"}}, "expect": "reserved"},
    {"name": "a stock save of the NES Classic", "doc_kind": "stock-save", "doc": {}, "expect": "ok", "legacy": true},
    {"name": "a worker request with no target is the NES default", "doc_kind": "worker-request", "request": {"cmd": "backup"}, "expect": "ok"},
    {"name": "a worker request for the NES gameplay capability", "doc_kind": "worker-request", "request": {"cmd": "x", "capability": "nes-gameplay"}, "expect": "ok"},
    {"name": "a worker request for NES", "doc_kind": "worker-request", "request": {"cmd": "x", "game_system": "nes"}, "expect": "ok"},
    {"name": "a worker request that asks for SNES gameplay", "doc_kind": "worker-request", "request": {"cmd": "x", "capability": "snes-gameplay"}, "expect": "reserved"},
    {"name": "a worker request that asks for a SNES Classic backup", "doc_kind": "worker-request", "request": {"cmd": "backup", "capability": "snes-classic-backup"}, "expect": "ok"},
    {"name": "a worker request that asks to prepare a SNES Classic", "doc_kind": "worker-request", "request": {"cmd": "prepare", "capability": "snes-classic-preparation"}, "expect": "ok"},
    {"name": "a worker request for CCS Mod or CCS Nucleus on a SNES Classic", "doc_kind": "worker-request", "request": {"cmd": "method", "capability": "snes-classic-addons"}, "expect": "ok"},
    {"name": "a worker request for Expert Mode on a SNES Classic", "doc_kind": "worker-request", "request": {"cmd": "files", "capability": "snes-classic-files"}, "expect": "ok"},
    {"name": "a worker request for a stock SNES save conversion by its capability", "doc_kind": "worker-request", "request": {"cmd": "x", "capability": "snes-stock-save-conversion"}, "expect": "reserved"},
    {"name": "a worker request that names the reserved core provider", "doc_kind": "worker-request", "request": {"cmd": "x", "provider": {"kind": "core", "id": "snes-unselected"}}, "expect": "reserved"},
    {"name": "a worker request with a provider of no known kind", "doc_kind": "worker-request", "request": {"cmd": "x", "provider": {"kind": "emulator", "id": "fceumm"}}, "expect": "unknown-id"},
    {"name": "a worker request whose provider is not an object", "doc_kind": "worker-request", "request": {"cmd": "x", "provider": "core:snes-unselected"}, "expect": "damaged"},
    {"name": "a worker request for the hidden SNES boot option", "doc_kind": "worker-request", "request": {"cmd": "x", "boot_option": "ccs-snes"}, "expect": "reserved"},
    {"name": "a worker request for the SNES controller", "doc_kind": "worker-request", "request": {"cmd": "x", "input": "snes-pad"}, "expect": "reserved"},
    {"name": "a worker request that carries a SNES target", "doc_kind": "worker-request", "request": {"cmd": "x", "ccs_target": {"schema": "ccs-target/1", "game_system": "snes"}}, "expect": "reserved"},
    {"name": "a worker request for the SNES Classic model by name", "doc_kind": "worker-request", "request": {"cmd": "x", "physical_model": "snes-classic-edition"}, "expect": "ok"},
    {"name": "a worker request for a stock SNES save conversion", "doc_kind": "worker-request", "request": {"cmd": "x", "save_adapter": "snes-classic-stock-battery"}, "expect": "reserved"},
    {"name": "a worker request for the NES Classic driver", "doc_kind": "worker-request", "request": {"cmd": "x", "driver": "clovershell-usb"}, "expect": "ok"}
  ]
}
