<!-- CCS Console Workbench window: the Windows app's theme (Theme.xaml, shared) plus the Workbench's own parts. Copyright (C) 2026 Rance9.
     GPL-3.0-or-later. Only the Workbench window uses this dictionary; the app's own windows keep Theme.xaml as it is. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wb="clr-namespace:CcsBackup.Ui">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/CcsBackupUi;component/Theme.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <SolidColorBrush x:Key="B.Side" Color="#FF131318"/>
  <SolidColorBrush x:Key="B.NavHover" Color="#12FFFFFF"/>
  <SolidColorBrush x:Key="B.NavOn" Color="#FF23232B"/>

  <!-- WB-UX-14: a focus mark (the red ring, a button's red edge, a link's underline) shows only while the keyboard is in use (FocusCue.cs:
       wb:FocusCue.Shown, set on the focused control after a key press, cleared by a mouse, pen or touch press). A click, or closing a
       window with the mouse, never leaves a ring behind; Tab, the arrow keys and closing a window with Escape or Enter show it. The
       Workbench's buttons below are the theme's (Theme.xaml, unchanged for Classic Cart Studio's own windows) with that one change. -->
  <Style x:Key="Btn" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
    <Setter Property="Background" Value="{StaticResource B.Surface2}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.Line2}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#80FFFFFF"/><Setter TargetName="bd" Property="Background" Value="#FF26262E"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#FF14141A"/></Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="wb:FocusCue.Shown" Value="True"/></MultiTrigger.Conditions>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Red3}"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="{StaticResource B.Red}"/>
    <Setter Property="BorderBrush" Value="#FFFF5A63"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource B.Red3}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource B.Red2}"/></Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="wb:FocusCue.Shown" Value="True"/></MultiTrigger.Conditions>
              <Setter TargetName="bd" Property="BorderBrush" Value="White"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.Line}"/>
    <Setter Property="FontWeight" Value="Normal"/>
  </Style>
  <Style x:Key="Btn.Link" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource B.Red3}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline"/></Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="wb:FocusCue.Shown" Value="True"/></MultiTrigger.Conditions>
              <Setter TargetName="t" Property="TextDecorations" Value="Underline"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- WB-UX-13: a picture's caption, the same everywhere (Help's screenshots, About Classic Cart Studio's screenshots, a picture opened
       larger, HOME Designer's theme examples): italic, smaller, directly under its picture (BackupWorkspace.PictureCaption) -->
  <Style x:Key="Wb.Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontStyle" Value="Italic"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="LineHeight" Value="18"/>
    <Setter Property="Foreground" Value="{StaticResource B.Ink2}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Margin" Value="2,6,0,0"/>
  </Style>

  <!-- the side list of sections: plain rows (a group's sections indented under its heading), the open one marked by a red bar, a lighter
       row and heavier text; keyboard focus draws a ring; a row that cannot be opened while a console task runs is dimmed -->
  <Style x:Key="Wb.Nav" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource B.Ink2}"/>
    <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="12,7,10,7"/>
    <Setter Property="Margin" Value="0,0,0,2"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="False"/>
            </Border>
            <Border x:Name="bar" Width="3" CornerRadius="1.5" Margin="0,8,0,8" HorizontalAlignment="Left" Background="Transparent"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource B.NavHover}"/><Setter Property="Foreground" Value="{StaticResource B.Ink}"/></Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="wb:FocusCue.Shown" Value="True"/></MultiTrigger.Conditions>
              <Setter TargetName="bd" Property="Background" Value="{StaticResource B.NavHover}"/><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.FocusRing}"/>
            </MultiTrigger>
            <Trigger Property="Tag" Value="on">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource B.NavOn}"/>
              <Setter TargetName="bar" Property="Background" Value="{StaticResource B.Red}"/>
              <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource B.Muted}"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- an entry at the level of the group headings (Dashboard): their size, weight and color, with the same open, hover and focus marks -->
  <Style x:Key="Wb.NavTop" TargetType="Button" BasedOn="{StaticResource Wb.Nav}">
    <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- a "Technical details" heading that opens and closes the details under it -->
  <Style x:Key="Wb.Disclosure" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{StaticResource B.Ink2}"/>
    <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="6,5,10,5" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource B.Hover}"/><Setter Property="Foreground" Value="{StaticResource B.Ink}"/></Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="wb:FocusCue.Shown" Value="True"/></MultiTrigger.Conditions>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.FocusRing}"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- every button's text: one line when there is room, wrapped (never cut off) when there is not -->
  <DataTemplate x:Key="Wb.ButtonText">
    <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
  </DataTemplate>

  <!-- a long choice is shortened with "…" in the box (the whole text shows in the open list) instead of running past the box -->
  <DataTemplate x:Key="Wb.ChoiceText">
    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
  </DataTemplate>
  <!-- check boxes and choices: their sentence wraps -->
  <DataTemplate x:Key="Wb.CheckText">
    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
  </DataTemplate>
  <!-- a clickable row (a folder in a file list): flat, lighter under the pointer -->
  <!-- a button that is only its content (a picture, an explained word): a focus ring while the keyboard is in use, a light hover -->
  <Style x:Key="Wb.Plain" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{StaticResource B.Red3}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ring" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent" SnapsToDevicePixels="True">
            <ContentPresenter RecognizesAccessKey="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ring" Property="Background" Value="{StaticResource B.NavHover}"/></Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="wb:FocusCue.Shown" Value="True"/></MultiTrigger.Conditions>
              <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource B.FocusRing}"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Wb.Row" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
    <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="6,6,6,6" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource B.Hover}"/></Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="wb:FocusCue.Shown" Value="True"/></MultiTrigger.Conditions>
              <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Hover}"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- a row in a list of backups: the row draws its own card; the list marks the chosen one with a red outline (no system highlight) -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="ring" BorderThickness="2" BorderBrush="Transparent" CornerRadius="10" Padding="0" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource B.Line2}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource B.Red}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The Workbench's text boxes, choice lists, check boxes and choices build on the shared theme's own styles; they are made in code
       (BackupWorkspace.DeriveStyles) from the theme's styles as the window finds them, so the theme's dark look is always kept. -->
</ResourceDictionary>
