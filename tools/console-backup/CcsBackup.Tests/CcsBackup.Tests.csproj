<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline tests of the console backup and restore engine (no console, no USB device is ever opened). GPL-3.0-or-later. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CcsBackup.Tests</AssemblyName>
    <RootNamespace>CcsBackup.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS0162</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CcsBackup\CcsBackup.csproj" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <!-- Developer Mode's test boot: the FEL protocol model of the loader's own tests, compiled here from where it stays -->
    <Compile Include="..\..\console-loader\CcsConsole.Tests\SimulatedFelDevice.cs" Link="Fel\SimulatedFelDevice.cs" />
  </ItemGroup>
</Project>
