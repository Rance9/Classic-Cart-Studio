    echo "began huse"
    if [ "$now" != "$copy" ]; then
      printf '%s\n' "$copy" > "$P/current.ccs-new" && sync && mv -f "$P/current.ccs-new" "$P/current" && sync || { rm -f "$P/current.ccs-new"; dumount; r huse "failed switch (not written again)"; }
    fi
    rm -f "$I/attempt-$att.json"; sync
    dumount || r huse "failed unmount"
    dmount ro,noload || r huse "failed readback mount"
    back=$(hcur); left=no; [ -e "$I/attempt-$att.json" ] && left=yes; dumount
    [ "$back" = "$copy" ] && [ "$left" = no ] || r huse "failed readback ($back $left)"
    r huse "ok $copy" ;;
  hdrop)
    copy=$2; keep=$3
    copyname "$copy" && copyname "$keep" && [ "$copy" != "$keep" ] || r hdrop "refused request"
    att=none; P="$HC/pkg"; I="$HC/install"; T="$ST/hdrop-sums"; mkdir -p "$ST"
    dmount ro,noload || r hdrop "failed mount"
    why=$(hfree) || { dumount; r hdrop "refused $why"; }
    cur=$(hcur); other=$(hother)
    [ "$cur" = "$keep" ] || { dumount; r hdrop "refused the HOME in use is not $keep ($cur)"; }
    [ -z "$other" ] || { dumount; r hdrop "refused an installation did not finish ($(echo $other))"; }
    [ -e "$P/$copy" ] || [ -e "$I/v-$copy.json" ] || { dumount; r hdrop "ok already $copy"; }
    named=$(hnamed "$copy"); [ "$named" = no ] || { dumount; r hdrop "refused an entry of Original Menu may name the copy $copy ($named; it is kept)"; }
    ok=no; [ -f "$I/v-$copy.json" ] && vsums "$I/v-$copy.json" 2>/dev/null | sed 's#  #  ./#' > "$T" && hcheck "$P/$copy" "$T" && ok=yes
    dumount
    [ "$ok" = yes ] || { rm -f "$T"; r hdrop "refused the copy $copy is not exactly what its record names (it is kept)"; }
    dmount rw || { rm -f "$T"; r hdrop "failed mount"; }
    now=$(hcur); { [ "$now" = "$keep" ] && [ -z "$(hother)" ] && hcheck "$P/$copy" "$T"; } || { dumount; rm -f "$T"; r hdrop "refused the console's HOME folders changed while it was read"; }
    echo "began hdrop"
    { ( cd "$P/$copy" && awk '{ print $2 }' "$T" | while read -r f; do rm -f "$f" || exit 1; done ) \
      && find "$P/$copy" -type d | sort -r | while read -r d; do rmdir "$d" || exit 1; done \
      && rm -f "$I/v-$copy.json" && sync; } || { dumount; rm -f "$T"; r hdrop "failed removal (stopped; the backup made before keeps the copy)"; }
    rm -f "$T"; dumount || r hdrop "failed unmount"
    dmount ro,noload || r hdrop "failed readback mount"
    gone=no; [ ! -e "$P/$copy" ] && [ ! -e "$I/v-$copy.json" ] && gone=yes; back=$(hcur); dumount
    [ "$gone" = yes ] && [ "$back" = "$keep" ] || r hdrop "failed readback ($gone $back)"
    r hdrop "ok $copy" ;;
  *) echo "ccsprep: unknown step" >&2; exit 2 ;;
esac
