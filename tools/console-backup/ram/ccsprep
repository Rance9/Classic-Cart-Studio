#!/bin/sh
# ccsprep: Classic Cart Studio's first-time console preparation. Copyright (C) 2026 Rance9. GPL-3.0-or-later; it runs Hakchi2 CE 3.9.3's own
# functions (GPL-3.0) from this image's pinned copy of hakchi.
# It runs in the console's RAM, in the Classic Cart Studio preparation image only (profile "prepare"), and does Hakchi2 CE 3.9.3's
# installation as fixed steps the PC asks for one at a time, in its order (tools/console-backup/CcsBackup Engine/Preparation.cs):
#   files     the data storage mounted (the only step that mounts it, read-write as hakchi's installation needs), hakchi's own mod_install
#             (or mod_repair) and the hakchi module's programs and libraries copied, its settings saved, the storage synced and unmounted
#   uboot     hakchi's u-boot (from the pinned hakchi.hmod) burned to the bootloader area, once, then read back
#   slot68    the console's ORIGINAL kernel copied to hakchi's spare slot, once, then read back (only when the slot is empty and the running
#             kernel is the original)
#   kernel    hakchi's kernel, with this console's system key added to its command line as hakchi does, burned once and read back
# Derived corrections (the pinned functions are sourced first, then these two are redefined here; the pinned files are not changed):
#   flashBoot     upstream burns a SECOND time when its validity check fails; here a failed check or readback is reported and nothing is
#                 burned again (the PC stops every later step)
#   installBoot2  upstream continues when backupBoot2 fails; here the original kernel's copy is its own step (slot68) and the PC refuses
#                 the kernel step unless that copy was made and read back (or already there)
# Return to Original Software (a console Classic Cart Studio prepared; the PC's ReturnEngine, its own write boundary): Hakchi2 CE 3.9.3's
# uninstall (script/install mod_uninstall without a kernel file) as checked steps in its order, after the PC verified that the console is
# exactly as Classic Cart Studio's preparation left it and backed it up in the same session:
#   ret-stage SIZE MD5  THIS console's own bootloader, from the backup made before preparing (the PC sends exactly SIZE bytes), kept in
#                    RAM only and refused unless its size and MD5 are the reviewed ones and ccsboot finds it a complete u-boot image with a
#                    correct checksum. Nothing is written to the console's storage. (hakchi's mod_uninstall instead pipes the word "default"
#                    into its flash tool, sntool 5833d00, whose source is not public: what that writes cannot be known before writing, so
#                    the way back never uses it.)
#   ret-kernel MD5   restoreBoot2: the spare slot's original kernel (refused unless its MD5 is the one the PC reviewed) burned once as the
#                    startup software and read back
#   ret-uboot NOW WANT  the staged bootloader burned once by ccsboot (Classic Cart Studio's own boot-stage writer, built from published
#                    source), only when the bootloader on the console is still NOW by both readers (ccsboot and the image's flash tool)
#                    and the staged file is still WANT; read back by both readers, which must both give WANT
#   ret-files        the data storage mounted, hakchi's files removed (rm -rf "$installpath", as mod_uninstall), unmounted
#   ret-table        hakchi's own sunxi-part shrink (mod_uninstall's last step); the PC reads the table back (ccsbr identify)
#   The data storage itself comes back afterwards by a restore of the backup made before preparing (the PC's RestoreEngine), in a new
#   session: the driver reads the storage table only when it starts.
# CCS Mod and CCS Nucleus, through hakchi's own route: at the console's next normal start hakchi's
# p7080_hmods first runs packs_uninstall on the names in $installpath/transfer/uninstall, then pack_install on every *.hmod there, then
# removes the folder and restarts. These steps only place files there (the PC's Preparation and MethodEngine, their own boundaries); the
# data storage is mounted only inside them, read-only without journal replay to read, read-write to write, and always unmounted again:
#   mstate           read-only: hakchi's version, the hakchi packages installed (its uninstall lists), CCS Nucleus's start setting
#                    (its registry: default, chooser, generation) and what already waits in the transfer folder (name and SHA-256)
#   method NAME SHA  this image's own copy of NAME.hmod (ccs-mod, ccs-nucleus or ccs-nucleus-chooser, refused unless its SHA-256 is
#                    SHA) written to the transfer folder through a new name and a rename, then read back from the storage (read-only)
#   unlist NAME...   a removal list naming one or more of those packages, in the order given (the chooser before CCS Nucleus), written
#                    the same way: hakchi runs each package's own uninstall
#   Both refuse when hakchi's files are not on the data storage, when a link is on the way, or when something else already waits under
#   that name; the same bytes already there are "ok already" (an interrupted operation is finished, never written twice).
#   nstart DEFAULT CHOOSER HOME SELECTION TIMEOUT   what opens at power-on: this image's own pinned CCS Nucleus program runs
#                    "ccs-nucleus start" on the data storage (DEFAULT native|ccs-home, CHOOSER always|never, HOME on|off: CCS HOME
#                    offered, SELECTION default|last, TIMEOUT 0-99 seconds, 0: wait for a choice): the first registry, or
#                    the one in force changed in place (the owner's own system images stay listed). Works before hakchi installs CCS
#                    Nucleus, whose install keeps a valid registry. Read back; the same setting already in force is "ok already"
# An owner's own system image as a CCS Nucleus choice (the PC's FirmwareEngine, Console Composer's Browse for Firmware; CCS Nucleus must
# be installed). The image goes to Nucleus's own folder, never to hakchi's firmware folders (hakchi starts the first image there by itself):
#   rput ID SIZE SHA      exactly SIZE bytes from the PC written to /var/lib/ccs/nucleus/staging/ID.hsqs through a new name (straight to
#                         the data storage: an image can be larger than the console's memory), refused unless they are SIZE bytes with
#                         that SHA-256 and a SquashFS image, and unless SIZE and 8,000,000 bytes more are free; read back
#   rimport ID SHA SIZE LABEL   this image's own pinned CCS Nucleus program (from its ccs-nucleus.hmod) runs "ccs-nucleus import" on the
#                         data storage: the staged image moved (one rename) to roots/ID.hsqs, recorded as Nucleus's data and added to the
#                         registry (LABEL: base64); read back: the registry names ID with SHA and the image has SHA
#   rdrop ID SHA          the reverse: only when roots/ID.hsqs is Nucleus's own unchanged file with SHA, "ccs-nucleus forget ID" (the
#                         registry), then the file removed and its record forgotten (the pinned library); read back
# CCS HOME's own package, which both methods start (the PC's Engine/HomePackage.cs; Preparation and MethodEngine), sent AFTER the session
# started (the FEL image limit applies only to this image), in the layout Classic Cart Studio's installer uses on a running console
# (tools/companion/console_engine/ccs_install.py): the copy /var/lib/ccs/pkg/COPY (COPY = <first 16 hex of its MANIFEST.json's SHA-256>.
# <attempt>), the pointer pkg/current naming the copy in use, the records install/v-COPY.json (the copy's files and their SHA-256) and
# install/attempt-ATTEMPT.json (an installation in progress), the saves' identity data/IDENTITY.json (written only when absent):
#   hput COPY SIZE SHA BYTES   exactly SIZE bytes from the PC (an archive: pkg/<the package's files>, rec/<the three records>) received
#                         into RAM, refused unless they are SIZE bytes with that SHA-256 and only plain members, and unless RAM holds them
#                         and BYTES (the package) and 8,000,000 bytes more are free on the data storage (every refusal decided with the
#                         storage mounted read-only, never read-write); then the attempt's and the copy's
#                         records, the files unpacked into staging/COPY and moved (one rename) to pkg/COPY; every file read back against the
#                         copy's record (the storage mounted again read-only). The copy in use is not touched. An unfinished attempt of the
#                         same copy is finished (its unpacked part replaced), never another one's
#   huse COPY PRIOR       the switch: only while pkg/current still names PRIOR (or "absent") and COPY reads back complete against its record:
#                         pkg/current replaced in one rename, the attempt's record removed; read back
#   hdrop COPY CURRENT    an earlier copy removed, after the switch: only while pkg/current names CURRENT (never COPY), no installation is
#                         unfinished, no entry of Original Menu names COPY's files (and none is recorded where it cannot be read now) and COPY
#                         is exactly what its record names (every file with its SHA-256, nothing else); then its files,
#                         its folders and its record removed; read back (the copy and its record gone, pkg/current unchanged). A copy that
#                         differs from its record is kept whole
# Every step prints "result <step> ok ..." or "result <step> failed <why>"; nothing is retried; no step formats, erases or repartitions
# anything beyond what hakchi's own mod_install does (it tunes the data storage's table and file system: sunxi-part tune) and its own
# mod_uninstall undoes (sunxi-part shrink).
CCS=$(cd "$(dirname "$0")/.." && pwd)
. "$CCS/env" || exit 90
[ "$(cat "$CCS/profile" 2>/dev/null)" = prepare ] || { echo "ccsprep: this image cannot prepare a console" >&2; exit 13; }
HMOD="$CCS/prep/hmod"
# hakchi's installation runs in the environment hakchi 3.9.3's /hakchi/init gives it (the system's usr and sbin, hakchi's etc, its PATH;
# links in the RAM root only), with its functions: preinit, preinit.d (the same files as hakchi.hmod's etc/preinit.d) and script/install
# (mod_install, mod_repair), sourced as script/base and script/transfer do
for dir in usr sbin; do [ -e "/$dir" ] || ln -nsf "$NEWROOT/$dir" "/" 2>/dev/null; done
ln -nsf "$HK/rootfs/etc" "/" 2>/dev/null
export PATH="/sbin:$HK/rootfs/bin:/bin:$NEWROOT/sbin:/usr/sbin:$NEWROOT/bin:/usr/bin"
export modname=hakchi modpath="$HK" mountpoint="$NEWROOT" temppath="$ST/prep"
mkdir -p "$temppath"
. "$HK/rootfs/etc/preinit" || exit 91
source_base "$HK/rootfs/etc/preinit.d" || exit 92
. "$HK/script/install" || exit 93
temppath="$ST/prep"   # b0000_defines sets /tmp; both are RAM, this keeps the steps' temporary files with ccsbr's
export cf_install=y cf_update=y cf_memboot=y

flashBoot(){
  local BN="$1"
  [ "$BN" -eq "$BN" ] 2>/dev/null || return 1
  local bootimg="$3" offset="$4"
  [ "$offset" -eq "$offset" ] 2>/dev/null || offset="$2"
  [ "$offset" -eq "$offset" ] 2>/dev/null || return 1
  isValidBootImage "$bootimg" || return 1
  sntool check -f "$bootimg" >/dev/null || return 1
  local md5i="$(dd status=none bs=128K "if=$bootimg" | md5sum | awk '{print $1}')"
  dd status=none bs=128K "if=$bootimg" | sunxi-flash "burn_boot$BN" "$offset" || { echo "burn failed" >&2; return 1; }
  local md5f="$(readBoot "$BN" "$offset" | md5sum | awk '{print $1}')"
  [ "$md5i" = "$md5f" ] && return 0
  echo "flash md5 mismatch! $md5i != $md5f (not burned again)" >&2
  return 1
}

installBoot2(){ echo "ccsprep: installBoot2 is replaced by the slot68 and kernel steps" >&2; return 1; }

r(){ echo "result $1 $2"; [ "$2" = ok ] || [ "${2#ok}" != "$2" ] && exit 0; exit 17; }
# the data storage for the method steps (as ccsfiles mounts it): read-only without journal replay, or read-write; always unmounted again
D="$NEWROOT/var/lib"
dmount(){ mountpoint -q "$D" && return 1; mkdir -p "$D"; mount -o "$1,noatime" "$DEV/nandc" "$D"; }
dumount(){ sync; umount "$D"; }
pkgname(){ [ "$1" = ccs-mod ] || [ "$1" = ccs-nucleus ] || [ "$1" = ccs-nucleus-chooser ]; }
rootid(){ echo "$1" | grep -qE '^[a-z0-9][a-z0-9-]{0,30}$'; }   # an owner image's option id (its path fits hakchi's 63-character loop name)
K=3.4.113.29-madmonkey   # the kernel an owner image starts with: hakchi 3.9.3's (it mounts the image as the console's system)
# CCS Nucleus is installed (hakchi lists it, its registry is there) and nothing on the way to its folders is a link
nfree(){ [ -f "$D/hakchi/hmod/uninstall-ccs-nucleus" ] && [ -f "$D/ccs/nucleus/registry" ] || { echo "CCS Nucleus is not installed"; return 1; }
  for x in ccs ccs/nucleus ccs/nucleus/staging ccs/nucleus/roots; do [ -L "$D/$x" ] && { echo "a link is on the way"; return 1; }; done; return 0; }
# the image's own pinned CCS Nucleus program and library, unpacked in RAM (never the copy on the console's storage)
npkg(){ X="$ST/nucleus-pkg"; rm -rf "$X"; mkdir -p "$X" && ( cd "$X" && tar -xzf "$CCS/prep/methods/ccs-nucleus.hmod" ) && [ -f "$X/bin/ccs-nucleus" ]; }
# CCS Nucleus's start setting as its registry keeps it: "DEFAULT CHOOSER HOME SELECTION TIMEOUT" (HOME on when CCS HOME is listed),
# none or invalid
rstart(){ local f="$D/ccs/nucleus/registry" e o
  [ -f "$f" ] && [ ! -L "$f" ] || { echo none; return; }
  e=$(tail -n 1 "$f"); [ "$(head -n 1 "$f")" = schema=ccs-boot-registry/1 ] && [ "${e#end=}" = "$(sed '$d' "$f" | sha256sum | cut -d' ' -f1)" ] || { echo invalid; return; }
  o=off; case " $(sed -n 's/^options=//p' "$f") " in *" ccs-home "*) o=on ;; esac
  echo "$(sed -n 's/^default=//p' "$f") $(sed -n 's/^chooser=//p' "$f") $o $(sed -n 's/^selection=//p' "$f") $(sed -n 's/^timeout=//p' "$f")"; }
# the transfer folder may be written: hakchi's files are there, nothing on the way is a link, and transfer is a real folder or absent
tfree(){ [ -f "$D/hakchi/rootfs/etc/preinit" ] || { echo "hakchi is not installed on the data storage"; return 1; }
  [ ! -L "$D/hakchi" ] && [ ! -L "$D/hakchi/transfer" ] && [ ! -L "$D/hakchi/transfer/hmod" ] || { echo "a link is on the way"; return 1; }
  [ ! -e "$D/hakchi/transfer" ] || [ -d "$D/hakchi/transfer" ] || { echo "the transfer folder is not a folder"; return 1; }
  [ ! -e "$D/hakchi/transfer/hmod" ] || [ -d "$D/hakchi/transfer/hmod" ] || { echo "the transfer folder's hmod folder is not a folder"; return 1; }; }
# where a package waits: hakchi installs transfer/*.hmod in sorted order and then transfer/hmod/*.hmod, so the chooser (which needs CCS
# Nucleus installed first, and whose name sorts before it) waits in transfer/hmod/
tpath(){ [ "$1" = ccs-nucleus-chooser ] && echo "$D/hakchi/transfer/hmod/$1.hmod" || echo "$D/hakchi/transfer/$1.hmod"; }
# CCS HOME's package (hput, huse): its places on the data storage; nothing on the way is a link, each folder is a real folder or absent
HC="$D/ccs"
copyname(){ echo "$1" | grep -qE '^[0-9a-f]{16}\.[0-9a-f]{8}$'; }
hfree(){ for x in ccs ccs/pkg ccs/install ccs/data ccs/staging ccs/pkg/current; do [ -L "$D/$x" ] && { echo "a link is on the way ($x)"; return 1; }; done
  for x in ccs ccs/pkg ccs/install ccs/data ccs/staging; do [ ! -e "$D/$x" ] || [ -d "$D/$x" ] || { echo "$x is not a folder"; return 1; }; done
  [ ! -e "$D/ccs/pkg/current" ] || [ -f "$D/ccs/pkg/current" ] || { echo "pkg/current is not a plain file"; return 1; }; }
# a copy's files as its record names them ("<sha256>  <path>"): install/v-COPY.json's "files" entries, the lines indented by two spaces
# (json.dumps sort_keys, indent 1: ccs_install.py and Engine/HomePackage.cs write it the same way)
vsums(){ awk -v re='^  "[A-Za-z0-9_][A-Za-z0-9._/-]*": "[0-9a-f]+",?$' 'index($0, " \"files\": {") == 1 { f = 1; next } f && substr($0, 1, 2) != "  " { f = 0 } f && $0 ~ re { split($0, a, "\""); print a[4] "  " a[2] }' "$1"; }
# hcheck DIR SUMS: every file SUMS names is in DIR with its SHA-256, and DIR holds nothing else (no other file, no link or special file)
hcheck(){ [ -s "$2" ] && [ -d "$1" ] && [ ! -L "$1" ] || return 1
  ( cd "$1" && sha256sum -c -s "$2" ) || return 1
  [ "$(cd "$1" && find . -type f | wc -l | tr -d ' ')" = "$(wc -l < "$2" | tr -d ' ')" ] && [ -z "$(cd "$1" && find . ! -type f ! -type d)" ]; }
# hexact DIR RECORD: hcheck against the record's own list, read through a pipe (mstate writes nothing, not even a file in RAM)
hexact(){ local n; [ -d "$1" ] && [ ! -L "$1" ] && [ -f "$2" ] || return 1
  n=$(vsums "$2" 2>/dev/null | wc -l | tr -d ' '); [ "$n" -gt 0 ] || return 1
  ( cd "$1" && vsums "$2" | sed 's#  #  ./#' | sha256sum -c -s ) || return 1
  [ "$(cd "$1" && find . -type f | wc -l | tr -d ' ')" = "$n" ] && [ -z "$(cd "$1" && find . ! -type f ! -type d)" ]; }
# RAM free for a received archive: MemFree only (the 3.4 kernel has no MemAvailable; what the page cache holds is not counted)
ramfree(){ awk '/^MemFree:/ { print $2 * 1024 }' /proc/meminfo; }
# the copy pkg/current names: "absent", the copy (the file is exactly "<copy>\n", as the installer writes it), or "other"
hcur(){ local v; [ -e "$HC/pkg/current" ] || { echo absent; return; }; v=$(head -n 1 "$HC/pkg/current" 2>/dev/null)
  if [ -f "$HC/pkg/current" ] && [ "$(wc -c < "$HC/pkg/current" | tr -d ' ')" = 26 ] && copyname "$v"; then echo "$v"; else echo other; fi; }
A="$ST/home"
hram(){ rm -rf "$ST/home"; }
hstage(){ rm -rf "$HC/staging/$copy"; }
# the records of unfinished installations other than this attempt's ($att)
# whether an entry of Original Menu names the copy's files: yes (a .desktop file in hakchi's folders on the data storage names
# ccs/pkg/COPY), unknown (not every entry could be read: the listing did not finish, an entry cannot be read, a link to a folder leads
# where nothing here reads, a link leads nowhere; or the console program recorded entries on a USB drive or SD card, which cannot be read
# now) or no. A link is never walked: an entry that is a link is read where it leads (hmap). Any other link matters where the console's
# menus list games, or on the way there (hakchi's game storage games/ and its overlay of the console's own games folder,
# rootfs/usr/share/games): there a link to a folder hides no entry when its real place is inside hakchi's folders on the data storage
# (read here) or, for a link to /var/squashfs/..., inside the console's system, which is mounted read-only (it was made before any copy
# existed); a link to a file holds no entries. Links elsewhere (hakchi's own programs, libraries and settings) are not where menus list games
# hmap LINK: where a link on the data storage leads, as this RAM system sees the console's paths: /var/squashfs/... the console's system
# at $NEWROOT, /var/lib/... the data storage under it, a relative target beside the link; any other absolute target is not known here
hmap(){ local t; t=$(readlink "$1") || return 1
  case "$t" in /var/squashfs/*) echo "$NEWROOT${t#/var/squashfs}" ;; /var/lib/*) echo "$NEWROOT$t" ;; /*) return 1 ;; *) echo "${1%/*}/$t" ;; esac; }
sysro(){ awk -v r="$NEWROOT" '$2 == r { n = split($4, a, ","); for (i = 1; i <= n; i++) if (a[i] == "ro") f = 1 } END { exit !f }' "$MOUNTS" 2>/dev/null; }
hlinkok(){ local p r h d s; p=$(hmap "$1") || return 1
  if [ -d "$p" ]; then
    r=$(realpath "$p" 2>/dev/null) && h=$(realpath "$D/hakchi" 2>/dev/null) && d=$(realpath "$D" 2>/dev/null) && s=$(realpath "$NEWROOT" 2>/dev/null) || return 1
    case "$(readlink "$1")" in
      /var/squashfs/*) case "$r/" in "$d"/*) return 1 ;; "$s"/*) sysro ;; *) return 1 ;; esac ;;
      *) case "$r/" in "$h"/*) return 0 ;; *) return 1 ;; esac ;;
    esac
  else [ -e "$p" ]; fi; }
hnamed(){ local o s
  if [ -L "$D/hakchi" ]; then echo unknown; return
  elif [ -d "$D/hakchi" ]; then
    o=$(find "$D/hakchi" \( -name '*.desktop' ! -type d \) -o \( -type l ! -name '*.desktop' \) 2>/dev/null; echo "end $?")
    [ "$(echo "$o" | tail -n 1)" = "end 0" ] || { echo unknown; return; }
    s=$(echo "$o" | sed '$d' | while IFS= read -r q; do
        case "$q" in "$D/hakchi/"*) ;; *) echo unknown; break ;; esac
        case "$q" in
          *.desktop) if [ -L "$q" ]; then q=$(hmap "$q") || { echo unknown; break; }; fi
            grep -qF "ccs/pkg/$1" "$q" 2>/dev/null; case $? in 0) echo yes; break ;; 1) ;; *) echo unknown; break ;; esac ;;
          "$D/hakchi/games"|"$D/hakchi/games/"*|"$D/hakchi/rootfs"|"$D/hakchi/rootfs/usr"|"$D/hakchi/rootfs/usr/share"|"$D/hakchi/rootfs/usr/share/games"|"$D/hakchi/rootfs/usr/share/games/"*)
            hlinkok "$q" || { echo unknown; break; } ;;
        esac
      done)
    case "$s" in yes) echo yes; return ;; unknown) echo unknown; return ;; esac
  elif [ -e "$D/hakchi" ]; then echo unknown; return; fi
  [ -f "$HC/owned/published.own" ] && grep -q '^file=[0-9a-f]\{64\} [0-7]\{4\} /media/' "$HC/owned/published.own" && { echo unknown; return; }; echo no; }
hother(){ local f; for f in "$HC/install"/attempt-*.json; do [ -f "$f" ] && [ "$f" != "$HC/install/attempt-$att.json" ] && echo "${f##*/}"; done; }

case "$1" in
  files)
    echo "began files"
    mount_base   # (its status is not a result: it ends with its uImage test)
    mountpoint -q "$mountpoint/var/lib" || { umount_base; r files "failed mount"; }
    # hakchi's settings as script/transfer loads them: the image's defaults, then the console's own when it has them
    [ -f "$HK/rootfs/etc/preinit.d/p0000_config" ] && . "$HK/rootfs/etc/preinit.d/p0000_config"
    source_config
    if [ -f "$preinit" ]; then mod_repair || { umount_base; r files "failed mod_repair"; }
    else mod_install || { umount_base; r files "failed mod_install"; }; fi
    ( cd "$HMOD" && copy "./bin/" "$rootfs/bin/" && copy "./lib/" "$rootfs/lib/" && copy "./lib/modules/" "$rootfs/lib/modules/" --delete ) || { umount_base; r files "failed copy"; }
    [ -f "$HMOD/var/version" ] && copy "$HMOD/var/version" "$installpath/var/version"
    save_config
    ok=no; [ -f "$preinit" ] && [ -d "$rootfs/bin" ] && ok=yes
    umount_base
    [ "$ok" = yes ] && r files "ok" || r files "failed check" ;;
  uboot)
    echo "began uboot"
    flashBoot1 "$HMOD/boot/uboot.bin" && r uboot "ok $(readBoot1 | md5sum | cut -d' ' -f1)" || r uboot "failed burn-or-readback" ;;
  slot68)
    haveBackup2 && r slot68 "ok already $(readBackup2 | md5sum | cut -d' ' -f1)"
    isOriginalBoot2 || r slot68 "failed the running kernel is not the original"
    readBoot2 > "$temppath/boot.img" || r slot68 "failed read"
    echo "began slot68"
    flashBoot2 "$temppath/boot.img" 68 || { rm -f "$temppath/boot.img"; r slot68 "failed burn-or-readback"; }
    rm -f "$temppath/boot.img"
    r slot68 "ok $(readBackup2 | md5sum | cut -d' ' -f1)" ;;
  kernel)
    haveBackup2 || r kernel "failed the original kernel is not in the spare slot"
    cp "$HMOD/boot/boot.img" "$temppath/boot.img" || r kernel "failed copy"
    insertKeyFile "$temppath/boot.img" || r kernel "failed key"
    echo "began kernel"
    flashBoot2 "$temppath/boot.img" || { rm -f "$temppath/boot.img"; r kernel "failed burn-or-readback"; }
    rm -f "$temppath/boot.img"
    r kernel "ok $(readBoot2 | md5sum | cut -d' ' -f1)" ;;
  # ---- Return to Original Software (the PC's ReturnEngine, under its own boundary): Hakchi2 CE 3.9.3's uninstall (script/install
  # mod_uninstall without a kernel file: restoreBoot2, the default u-boot, hakchi's files removed, sunxi-part shrink) as checked steps in
  # its order, each run once; the PC gives the MD5 it reviewed for what a step replaces, and the step refuses if the console differs.
# The one difference from mod_uninstall: the bootloader is this console's own, staged first (ret-stage), not the flash tool's "default".
  ret-stage)
    size=$2; want=$3
    echo "$size" | grep -qE '^[1-9][0-9]{0,6}$' && echo "$want" | grep -qE '^[0-9a-f]{32}$' || r ret-stage "refused request"
    stage="$ST/ret-boot1.bin"; rm -f "$stage"
    head -c "$size" > "$stage"
    got=$(md5sum < "$stage" | cut -d' ' -f1); n=$(wc -c < "$stage" | tr -d ' ')
    [ "$n" = "$size" ] && [ "$got" = "$want" ] || { rm -f "$stage"; r ret-stage "refused received-mismatch $got $n"; }
    "$CCS/bin/ccsboot" check "$stage" >/dev/null 2>&1 || { rm -f "$stage"; r ret-stage "refused not a complete u-boot image"; }
    r ret-stage "ok $want $size" ;;
  ret-kernel)
    want=$2; echo "$want" | grep -qE '^[0-9a-f]{32}$' || r ret-kernel "refused md5"
    isOriginalBoot2 && r ret-kernel "ok already $(readBoot2 | md5sum | cut -d' ' -f1)"
    haveBackup2 || r ret-kernel "failed the spare slot holds no original kernel"
    readBackup2 > "$temppath/boot.img" || r ret-kernel "failed read"
