<!-- Classic Cart Studio for Windows: the native theme. Dark surfaces, Nintendo red as a restrained accent, silver text, rounded
     controls with quiet hover states. Everything the native shell draws (title bar, menu, dialogs, loading and error states) uses
     these resources so it reads as one application with the website. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- palette (mirrors the website's variables) -->
  <Color x:Key="C.Bg">#FF101014</Color>
  <Color x:Key="C.Bar">#FF141419</Color>
  <Color x:Key="C.Surface">#FF18181E</Color>
  <Color x:Key="C.Surface2">#FF1F1F26</Color>
  <Color x:Key="C.Line">#1EFFFFFF</Color>
  <Color x:Key="C.Line2">#30FFFFFF</Color>
  <Color x:Key="C.Ink">#FFF3F1EC</Color>
  <Color x:Key="C.Ink2">#FFD6D4CE</Color>
  <Color x:Key="C.Muted">#FF9C9A95</Color>
  <Color x:Key="C.Red">#FFE4000F</Color>
  <Color x:Key="C.Red2">#FFB1000C</Color>
  <Color x:Key="C.Red3">#FFFF3B45</Color>
  <Color x:Key="C.Ok">#FF34D16E</Color>
  <Color x:Key="C.Warn">#FFF0A030</Color>
  <SolidColorBrush x:Key="B.Bg" Color="{StaticResource C.Bg}"/>
  <SolidColorBrush x:Key="B.Bar" Color="{StaticResource C.Bar}"/>
  <SolidColorBrush x:Key="B.Surface" Color="{StaticResource C.Surface}"/>
  <SolidColorBrush x:Key="B.Surface2" Color="{StaticResource C.Surface2}"/>
  <SolidColorBrush x:Key="B.Line" Color="{StaticResource C.Line}"/>
  <SolidColorBrush x:Key="B.Line2" Color="{StaticResource C.Line2}"/>
  <SolidColorBrush x:Key="B.Ink" Color="{StaticResource C.Ink}"/>
  <SolidColorBrush x:Key="B.Ink2" Color="{StaticResource C.Ink2}"/>
  <SolidColorBrush x:Key="B.Muted" Color="{StaticResource C.Muted}"/>
  <SolidColorBrush x:Key="B.Red" Color="{StaticResource C.Red}"/>
  <SolidColorBrush x:Key="B.Red2" Color="{StaticResource C.Red2}"/>
  <SolidColorBrush x:Key="B.Red3" Color="{StaticResource C.Red3}"/>
  <SolidColorBrush x:Key="B.Ok" Color="{StaticResource C.Ok}"/>
  <SolidColorBrush x:Key="B.Warn" Color="{StaticResource C.Warn}"/>
  <SolidColorBrush x:Key="B.Hover" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="B.Pressed" Color="#22FFFFFF"/>
  <FontFamily x:Key="F.Ui">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
  <FontFamily x:Key="F.Display">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
  <FontFamily x:Key="F.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="F.Mono">Cascadia Mono, Consolas, monospace</FontFamily>

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
    <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
  </Style>
  <Style x:Key="T.Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{StaticResource B.Muted}"/>
  </Style>
  <Style x:Key="T.Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{StaticResource B.Muted}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
  </Style>
  <Style x:Key="T.Title" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{StaticResource F.Display}"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- buttons: rounded, dark, quiet hover; .Primary is the Nintendo red -->
  <Style x:Key="Btn" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
    <Setter Property="Background" Value="{StaticResource B.Surface2}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.Line2}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#80FFFFFF"/><Setter TargetName="bd" Property="Background" Value="#FF26262E"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#FF14141A"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Red3}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="{StaticResource B.Red}"/>
    <Setter Property="BorderBrush" Value="#FFFF5A63"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource B.Red3}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource B.Red2}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="White"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.Line}"/>
    <Setter Property="FontWeight" Value="Normal"/>
  </Style>
  <!-- hyperlink-looking button -->
  <Style x:Key="Btn.Link" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource B.Red3}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- caption buttons (minimize / maximize / close) and the App tools button in the title bar -->
  <Style x:Key="Caption" TargetType="Button">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource B.Ink2}"/>
    <Setter Property="FontFamily" Value="{StaticResource F.Icons}"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" TextOptions.TextFormattingMode="Display"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource B.Hover}"/><Setter Property="Foreground" Value="White"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource B.Pressed}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource B.Hover}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Caption.Close" TargetType="Button" BasedOn="{StaticResource Caption}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" TextOptions.TextFormattingMode="Display"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#FFC42B1C"/><Setter Property="Foreground" Value="White"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#FF9E2213"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource B.Hover}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- App tools: the same menu anatomy as the website's menus (warm charcoal surface, a red top accent, a head with a badge, labeled
       groups, rows of a 30 px icon box and a label, a red focus ring for the keyboard). Each row's glyph is its Tag. -->
  <LinearGradientBrush x:Key="B.MenuSurface" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF23242C" Offset="0"/><GradientStop Color="#FF1A1C23" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="B.MenuEdge" Color="#FF4B414A"/>
  <LinearGradientBrush x:Key="B.Accent" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FFFF616F" Offset="0"/><GradientStop Color="#FFC9334A" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="B.Badge" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF77313E" Offset="0"/><GradientStop Color="#FF402530" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="B.IconBox" Color="#FF34313E"/>
  <SolidColorBrush x:Key="B.GroupLabel" Color="#FFC0B7C1"/>
  <SolidColorBrush x:Key="B.FocusRing" Color="#FFFF616F"/>
  <Style x:Key="MenuItemBtn" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
    <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="6,5,10,5"/>
    <Setter Property="MinHeight" Value="42"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="10" Padding="{TemplateBinding Padding}" Margin="8,1" SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="ib" Width="30" Height="30" CornerRadius="8" Background="{StaticResource B.IconBox}" VerticalAlignment="Center">
                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource F.Icons}" FontSize="15" Foreground="{StaticResource B.Ink}" FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#11FFFFFF"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource B.Pressed}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="Background" Value="#11FFFFFF"/><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.FocusRing}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="MenuGroup" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource B.GroupLabel}"/>
    <Setter Property="Margin" Value="18,10,12,4"/>
  </Style>
  <Style x:Key="MenuSep" TargetType="Border">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="#FF3A3C48"/>
    <Setter Property="Margin" Value="14,8,14,6"/>
  </Style>

  <!-- dark scroll bars everywhere in Classic Cart Studio's own windows and in CCS Console Workbench (which uses this theme): a rounded
       thumb on the window's own background, vertical and horizontal (each moving the right way), a click beside the thumb pages, no
       arrow buttons; the square where two bars meet is dark too (the ScrollViewer style below) -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="t" Background="#FF4A4A58" CornerRadius="4" Margin="2"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="#FF6C6C80"/></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter TargetName="t" Property="Background" Value="#FF8A8AA0"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="12"/>
    <Setter Property="MinWidth" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="MinHeight" Value="12"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                  <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
  <!-- the square where a vertical and a horizontal scroll bar meet takes Windows' control color in WPF's own ScrollViewer: transparent here -->
  <Style TargetType="ScrollViewer">
    <Style.Resources>
      <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
    </Style.Resources>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="#FF0B0B0E"/>
    <Setter Property="Foreground" Value="{StaticResource B.Ink2}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontFamily" Value="{StaticResource F.Mono}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="CaretBrush" Value="White"/>
    <Setter Property="SelectionBrush" Value="{StaticResource B.Red2}"/>
  </Style>
  <!-- check boxes and choices (round boxes), shared by every CCS window: an 18-pixel box (Windows' own is 13) with 8 pixels between it and
       its words, which wrap beside it; the whole row, words and gap included, takes the click. Unchecked: a dark box with a light edge;
       checked: the red box with a white check; mixed (part of a group): the red box with a white bar; a chosen choice: the red circle with
       a white dot. The pointer over it lightens the edge (red ones lighten too); pressed darkens; unavailable dims the box and its words.
       Keyboard focus: a red ring around the box, drawn in the control's BorderBrush, which the styles set only while the keyboard has the
       focus (the Workbench: only while the keyboard is in use, Workbench.xaml). -->
  <ControlTemplate x:Key="Ccs.CheckBox" TargetType="CheckBox">
    <Grid x:Name="root" Background="Transparent" SnapsToDevicePixels="True">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Width="18" Height="18" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
        <Border x:Name="ring" Margin="-3" CornerRadius="6" BorderThickness="2" BorderBrush="{TemplateBinding BorderBrush}"/>
        <Border x:Name="box" CornerRadius="4" BorderThickness="1.5" Background="#FF0B0B0E" BorderBrush="{StaticResource B.Muted}">
          <Grid>
            <Path x:Name="check" Data="M 3.3,7.7 L 6.3,10.7 L 11.7,4.7" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
            <Rectangle x:Name="mixed" Width="8" Height="2" RadiusX="1" RadiusY="1" Fill="White" Visibility="Collapsed"/>
          </Grid>
        </Border>
      </Grid>
      <ContentPresenter Grid.Column="1" Focusable="False" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{StaticResource B.Ink2}"/><Setter TargetName="box" Property="Background" Value="#FF17171D"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="box" Property="Background" Value="#FF23232B"/></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="check" Property="Visibility" Value="Visible"/><Setter TargetName="box" Property="Background" Value="{StaticResource B.Red}"/><Setter TargetName="box" Property="BorderBrush" Value="{StaticResource B.Red}"/></Trigger>
      <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="mixed" Property="Visibility" Value="Visible"/><Setter TargetName="box" Property="Background" Value="{StaticResource B.Red}"/><Setter TargetName="box" Property="BorderBrush" Value="{StaticResource B.Red}"/></Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsChecked" Value="True"/></MultiTrigger.Conditions>
        <Setter TargetName="box" Property="Background" Value="{StaticResource B.Red3}"/><Setter TargetName="box" Property="BorderBrush" Value="{StaticResource B.Red3}"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsChecked" Value="{x:Null}"/></MultiTrigger.Conditions>
        <Setter TargetName="box" Property="Background" Value="{StaticResource B.Red3}"/><Setter TargetName="box" Property="BorderBrush" Value="{StaticResource B.Red3}"/>
      </MultiTrigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="root" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="Ccs.RadioButton" TargetType="RadioButton">
    <Grid x:Name="root" Background="Transparent" SnapsToDevicePixels="True">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Width="18" Height="18" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
        <Ellipse x:Name="ring" Margin="-3" StrokeThickness="2" Stroke="{TemplateBinding BorderBrush}"/>
        <Ellipse x:Name="box" StrokeThickness="1.5" Fill="#FF0B0B0E" Stroke="{StaticResource B.Muted}"/>
        <Ellipse x:Name="dot" Width="8" Height="8" Fill="White" Visibility="Collapsed"/>
      </Grid>
      <ContentPresenter Grid.Column="1" Focusable="False" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="Stroke" Value="{StaticResource B.Ink2}"/><Setter TargetName="box" Property="Fill" Value="#FF17171D"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="box" Property="Fill" Value="#FF23232B"/></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="dot" Property="Visibility" Value="Visible"/><Setter TargetName="box" Property="Fill" Value="{StaticResource B.Red}"/><Setter TargetName="box" Property="Stroke" Value="{StaticResource B.Red}"/></Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsChecked" Value="True"/></MultiTrigger.Conditions>
        <Setter TargetName="box" Property="Fill" Value="{StaticResource B.Red3}"/><Setter TargetName="box" Property="Stroke" Value="{StaticResource B.Red3}"/>
      </MultiTrigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="root" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
    <Setter Property="Template" Value="{StaticResource Ccs.CheckBox}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Style.Triggers>
      <Trigger Property="HasContent" Value="True"><Setter Property="Padding" Value="8,0,0,0"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource B.Red3}"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
    <Setter Property="Template" Value="{StaticResource Ccs.RadioButton}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Style.Triggers>
      <Trigger Property="HasContent" Value="True"><Setter Property="Padding" Value="8,0,0,0"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource B.Red3}"/></Trigger>
    </Style.Triggers>
  </Style>
  <!-- the Workbench's choice lists and expanding folders (dark, like the text boxes) -->
  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Pressed}"/></Trigger>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Box" Background="#FF0B0B0E" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" CornerRadius="6">
                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource F.Icons}" FontSize="10" Foreground="{StaticResource B.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource B.Muted}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter IsHitTestVisible="False" Margin="10,5,30,5" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
              <Border Background="{StaticResource B.Surface2}" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" CornerRadius="6" Margin="0,2,0,0"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#FFE4000F" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/></Setter.Value></Setter></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource B.Surface2}"/>
    <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.Line2}"/>
    <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
