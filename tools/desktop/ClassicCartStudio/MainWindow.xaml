<Window x:Class="ClassicCartStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:ClassicCartStudio"
        Title="Classic Cart Studio" MinWidth="720" MinHeight="480" Width="1440" Height="920"
        Background="{StaticResource B.Bg}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" Icon="pack://application:,,,/app.ico">
  <!-- custom chrome (36 px caption, native resize borders, Snap Layouts) is attached in code so that this window's message hook
       is registered before WindowChrome's own hook (see MainWindow.xaml.cs) -->
  <Window.Resources>
    <!-- the status bar's look (the approved design): charcoal a little lighter than the page, a thin gray line above, muted labels, light
         collection name, a red text link; keyboard focus shows the app's red focus ring (only for the keyboard: FocusVisualStyle) -->
    <SolidColorBrush x:Key="SB.Back" Color="#FF1C1C22"/>
    <SolidColorBrush x:Key="SB.Line" Color="#FF34343C"/>
    <SolidColorBrush x:Key="SB.Muted" Color="#FFB8B8C2"/>
    <SolidColorBrush x:Key="SB.Name" Color="#FFEEEEF2"/>
    <SolidColorBrush x:Key="SB.Link" Color="#FFFF5D6C"/>
    <SolidColorBrush x:Key="SB.LinkPressed" Color="#FFE24A58"/>
    <Style x:Key="SB.Focus">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Border Margin="-3,-1" BorderBrush="{StaticResource B.FocusRing}" BorderThickness="2" CornerRadius="5" SnapsToDevicePixels="True"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SB.Text" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource SB.Muted}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SB.LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource SB.Link}"/>
      <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="5,4"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource SB.Focus}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <!-- the whole padded area takes the click (a comfortable target around the words) -->
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" TextOptions.TextFormattingMode="Ideal"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="t" Property="Foreground" Value="{StaticResource SB.LinkPressed}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="root">
    <Grid.RowDefinitions>
      <RowDefinition Height="36"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- title bar: charcoal, icon, title, a restrained red accent; menu + caption buttons on the right -->
    <Grid x:Name="titleBar" Background="{StaticResource B.Bar}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
        <Image x:Name="titleIcon" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
        <TextBlock x:Name="titleText" Text="Classic Cart Studio" Margin="9,0,0,1" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource B.Ink}"/>
        <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource B.Red}" Margin="8,1,0,0" VerticalAlignment="Center" ToolTip="Classic Cart Studio for Windows" x:Name="accentDot"/>
        <TextBlock x:Name="stateText" Margin="10,0,0,1" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource B.Muted}" Text=""/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button x:Name="menuBtn" Style="{StaticResource Caption}" Content="&#xE713;" FontSize="14" ToolTip="App tools (F10)" AutomationProperties.Name="App tools" Click="MenuBtn_Click"/>
        <Button x:Name="minBtn" Style="{StaticResource Caption}" Content="&#xE921;" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="Min_Click"/>
        <Button x:Name="maxBtn" Style="{StaticResource Caption}" Content="&#xE922;" ToolTip="Maximize" AutomationProperties.Name="Maximize" Click="Max_Click"/>
        <Button x:Name="closeBtn" Style="{StaticResource Caption.Close}" Content="&#xE8BB;" ToolTip="Close" AutomationProperties.Name="Close" Click="Close_Click"/>
      </StackPanel>
    </Grid>
    <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{StaticResource B.Line}"/>

    <!-- the website -->
    <!-- WebView2 is a child HWND (WPF cannot draw over it): the WPF loading state covers only the moment before the browser exists;
         from then on the branded Loading.html inside WebView2 is the loading state, so the page is never hidden while it loads -->
    <wv2:WebView2 Grid.Row="1" x:Name="web" DefaultBackgroundColor="#FF101014"/>

    <!-- loading state: branded, lightweight, shown only until the website has rendered -->
    <Grid Grid.Row="1" x:Name="loading" Background="{StaticResource B.Bg}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
        <!-- the app icon: the frame of app.ico that fits this size at the window's scale (MainWindow.ApplyIcons), never the stretched 16 px one -->
        <Image x:Name="loadIcon" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,14" AutomationProperties.Name=""/>
        <!-- the approved wordmark (tools/publish/assets/brand-wordmark.png, drawn by make_installer_art.py) -->
        <Image Source="pack://application:,,,/brand-wordmark.png" Width="192" Height="46" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,16" AutomationProperties.Name="Classic Cart Studio"/>
        <!-- pixel-style progress: eight blocks that light up left to right (paused when the system has animations off) -->
        <StackPanel x:Name="blocks" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
          <Border Width="18" Height="8" Margin="2,0" Background="{StaticResource B.Surface2}"/><Border Width="18" Height="8" Margin="2,0" Background="{StaticResource B.Surface2}"/><Border Width="18" Height="8" Margin="2,0" Background="{StaticResource B.Surface2}"/><Border Width="18" Height="8" Margin="2,0" Background="{StaticResource B.Surface2}"/>
          <Border Width="18" Height="8" Margin="2,0" Background="{StaticResource B.Surface2}"/><Border Width="18" Height="8" Margin="2,0" Background="{StaticResource B.Surface2}"/><Border Width="18" Height="8" Margin="2,0" Background="{StaticResource B.Surface2}"/><Border Width="18" Height="8" Margin="2,0" Background="{StaticResource B.Surface2}"/>
        </StackPanel>
        <TextBlock x:Name="loadingText" Text="Starting…" HorizontalAlignment="Center" Style="{StaticResource T.Muted}"/>
      </StackPanel>
    </Grid>

    <!-- the status bar (StatusBar.cs): a row of its own below the page, so the page, its dialogs and a wizard's buttons always end above
         it. Left: the open collection and its game count (the page reports them); the middle stays empty; right: this program's running
         version and Check for Updates. One row while it fits; then only the collection name is shortened; then two centered rows. -->
    <local:StatusBarPanel Grid.Row="2" x:Name="statusBar" Background="{StaticResource SB.Back}" LineBrush="{StaticResource SB.Line}" AutomationProperties.Name="Status bar">
      <local:StatusItem x:Name="sbCollection" FocusVisualStyle="{StaticResource SB.Focus}" Background="Transparent">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource SB.Text}" Text="Collection:" Margin="0,0,5,0"/>
          <TextBlock DockPanel.Dock="Right" Style="{StaticResource SB.Text}" x:Name="sbGames" Text="· Games: —" Margin="5,0,0,0"/>
          <TextBlock x:Name="sbName" Style="{StaticResource SB.Text}" Text="None" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </DockPanel>
      </local:StatusItem>
      <StackPanel Orientation="Horizontal" x:Name="sbApp">
        <TextBlock x:Name="sbVersion" Style="{StaticResource SB.Text}"/>
        <TextBlock Style="{StaticResource SB.Text}" Text="·" Margin="5,0,0,0"/>
        <Button x:Name="sbUpdate" Style="{StaticResource SB.LinkButton}" Content="Check for Updates" VerticalAlignment="Center" Click="StatusUpdate_Click"/>
      </StackPanel>
    </local:StatusBarPanel>

    <!-- App tools (popup under the title-bar button): the Windows app's own commands, grouped like the website's menus (head, labeled
         groups, 30 px icon boxes, Exit set apart). The page's Studio menu is a different menu: help, backup and legal for the Studio. -->
    <!-- opaque popup on purpose: WebView2's child window shows through layered (transparent) popups -->
    <Popup x:Name="menuPopup" PlacementTarget="{Binding ElementName=menuBtn}" Placement="Custom" StaysOpen="False" AllowsTransparency="False" PopupAnimation="None">
      <Border Background="{StaticResource B.MenuSurface}" BorderBrush="{StaticResource B.MenuEdge}" BorderThickness="1" Width="312">
        <StackPanel x:Name="menuItems" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="App tools">
          <Border Height="3" Background="{StaticResource B.Accent}"/>
          <Grid Margin="12,10,12,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource B.Badge}"><Image x:Name="menuIcon" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="App Tools" FontSize="15" FontWeight="Bold"/>
              <TextBlock Text="Classic Cart Studio for Windows" Style="{StaticResource T.Muted}" FontSize="12"/>
            </StackPanel>
          </Grid>
          <TextBlock Style="{StaticResource MenuGroup}" Text="WINDOW"/>
          <Button Style="{StaticResource MenuItemBtn}" Click="Menu_Reload" AutomationProperties.Name="Reload" Tag="&#xE72C;" Content="Reload"/>
          <Button Style="{StaticResource MenuItemBtn}" Click="Menu_OpenSite" AutomationProperties.Name="Open ClassicCartStudio.com in your browser" Tag="&#xE774;" Content="Open Website"/>
          <TextBlock Style="{StaticResource MenuGroup}" Text="TOOLS"/>
          <Button Style="{StaticResource MenuItemBtn}" Click="Menu_DataFolder" AutomationProperties.Name="Open Data Folder" Tag="&#xE8B7;" Content="Open Data Folder"/>
          <Button Style="{StaticResource MenuItemBtn}" Click="Menu_Diagnostics" AutomationProperties.Name="Diagnostics" Tag="&#xE9D9;" Content="Diagnostics"/>
          <TextBlock Style="{StaticResource MenuGroup}" Text="UPDATES &amp; ABOUT"/>
          <Button Style="{StaticResource MenuItemBtn}" Click="Menu_Updates" AutomationProperties.Name="Check for Updates" Tag="&#xE896;" Content="Check for Updates"/>
          <Button Style="{StaticResource MenuItemBtn}" Click="Menu_About" AutomationProperties.Name="About Classic Cart Studio" Tag="&#xE946;" Content="About Classic Cart Studio"/>
          <Border Style="{StaticResource MenuSep}"/>
          <Button Style="{StaticResource MenuItemBtn}" Click="Menu_Exit" AutomationProperties.Name="Exit" Tag="&#xE7E8;" Content="Exit" Margin="0,0,0,6"/>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>
