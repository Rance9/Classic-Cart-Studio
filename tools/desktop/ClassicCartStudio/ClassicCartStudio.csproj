<Project Sdk="Microsoft.NET.Sdk">
  <!-- Classic Cart Studio for Windows: a WPF window (custom dark chrome) that shows the live website (https://classiccartstudio.com/)
       in WebView2 and starts, supervises and stops the Python backend (ClassicCartStudioBackend.exe, headless).
       .NET Framework 4.8 is part of Windows 10/11. The Microsoft Edge WebView2 Runtime is a separate Microsoft component: Setup checks it
       (ClassicCartStudio.exe with its runtime-check option) and installs it from Microsoft's bundled offline installer when it is missing (installer.iss). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ClassicCartStudio</AssemblyName>
    <RootNamespace>ClassicCartStudio</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ApplicationIcon>..\..\publish\assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.11.6</Version>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Product>Classic Cart Studio</Product>
    <AssemblyTitle>Classic Cart Studio</AssemblyTitle>
    <Company>Rance9 LLC</Company>
    <Copyright>Classic Cart Studio project (independent; not affiliated with Nintendo)</Copyright>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <StartupObject>ClassicCartStudio.Program</StartupObject>
    <!-- this release's channel ("preview" or "production"): the repository's CHANNEL file, recorded in the program (App.Channel) for its
         window title, About and update checks; the version is VERSION, passed by the release build as -p:Version -->
    <CcsChannel Condition="'$(CcsChannel)' == ''">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\..\CHANNEL').Trim())</CcsChannel>
  </PropertyGroup>
  <Target Name="CcsCheckChannel" BeforeTargets="CoreCompile">
    <Error Condition="'$(CcsChannel)' != 'preview' And '$(CcsChannel)' != 'production'" Text="CHANNEL must be preview or production (it is '$(CcsChannel)')" />
  </Target>
  <ItemGroup>
    <AssemblyMetadata Include="ReleaseChannel" Value="$(CcsChannel)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3296.44" />
    <!-- CCS Console Workbench is not built into this program: Setup installs its single-file program beside it (workbench\, the same file
         the standalone release publishes) and this program starts it (WorkbenchLauncher.cs) -->
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <EmbeddedResource Include="Recovery.html" LogicalName="Recovery.html" />
    <EmbeddedResource Include="Loading.html" LogicalName="Loading.html" />
    <Resource Include="..\..\publish\assets\app.ico" Link="app.ico" />
    <Resource Include="..\..\publish\assets\brand-wordmark.png" Link="brand-wordmark.png" />
  </ItemGroup>
</Project>
