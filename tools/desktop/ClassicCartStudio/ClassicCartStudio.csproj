<Project Sdk="Microsoft.NET.Sdk">
  <!-- Classic Cart Studio for Windows: a thin WebView2 host for the live website (https://classiccartstudio.com/) that starts,
       supervises and stops the existing Python backend (NESClassicCollectionStudioCompanion.exe, headless). .NET Framework 4.8 is
       part of Windows 10/11, so nothing else has to be installed; the WebView2 runtime ships with Microsoft Edge. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ClassicCartStudio</AssemblyName>
    <RootNamespace>ClassicCartStudio</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ApplicationIcon>..\..\publish\assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.2.0</Version>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Product>Classic Cart Studio</Product>
    <AssemblyTitle>Classic Cart Studio</AssemblyTitle>
    <Company>Rance9</Company>
    <Copyright>Classic Cart Studio project (independent; not affiliated with Nintendo)</Copyright>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3296.44" />
    <EmbeddedResource Include="Recovery.html" LogicalName="Recovery.html" />
  </ItemGroup>
</Project>
