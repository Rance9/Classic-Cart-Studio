#!/bin/sh
# ccs-nucleus: CCS Nucleus on the console. Classic Cart Studio's start chooser and boot registry around the normal Hakchi platform: the
# console's own environment stays an intact normal choice ("native"), beside CCS HOME and the owner's own system images.
# Copyright (C) 2026 Rance9. GPL-3.0-or-later. BusyBox ash (hakchi 3.9.3's BusyBox 1.29).
#
# Where it runs (DESIGN.md "Insertion point"; nothing of hakchi's or anyone else's is replaced):
#   early CFG            hakchi's preinit, from p7060_ccsnucleus (after p7020_usb, before p7070_firmware loads a system image),
#                        CCS_ROOT=/newroot. Decides which system this start uses; prints one line
#                        "ccsn-decision KIND ID IMAGE RESTORE WHY" (IMAGE: the system image for hakchi's cfg_firmware for THIS start
#                        only, or "-"; RESTORE: the owner's own cfg_firmware value to put back after a failed attempt, or "-")
#   loaded IMAGE         hakchi's preinit, from p7071_ccsnucleus (right after p7070_firmware): whether hakchi mounted that image
#   ui-start | ui-stop   the console's start scripts, S81ccs-nucleus (after the S80 scripts, before the console's own menu start
#                        S81clover-mcp, which it never replaces): the chooser, CCS HOME, or straight on to the console's own start
#   choose               the menu entry "CCS Nucleus" in the console's own menu: the chooser from there
# The chooser on the TV is the native HOME program's chooser mode (home/bin/ccs-home-armv7 --choose in the CCS HOME package in force;
# tools/console-simulator/core/chooser.c): this script decides what is offered and acts on its one answer; the program writes nothing.
# Management (the PC, over hakchi's shell):
#   import STAGED ID SHA256 BYTES LABEL [KERNEL]   an owner's system image, already uploaded to /var/lib/ccs/nucleus/staging/, moved
#                        into Nucleus's own folder (roots/ID.hsqs) and added as an option. Nothing in hakchi's firmware folders is ever
#                        written, moved or removed: hakchi's generic transfer branch (script/transfer) deletes every other image there
#                        and is never used.
#   register-foreign PATH ID LABEL   an image the owner already keeps in hakchi's firmware folder, added as an option by reference
#                        (hash and size recorded; not moved, not claimed, never removed by Nucleus)
#   forget ID            an option removed from the registry (its image file is kept)
#   registry-install FILE   a sealed registry made by the PC (ccs-boot-registry/1), checked, then put in force with one rename
#   set default|selection|chooser|timeout VALUE
#   preinstall FILES | postinstall FILES | activate | take-over | remove [keep|remove-data] | entry add|remove | status
# Every management command ends with one line "result <command> ok ..." or "result <command> failed|refused <why>".
ME="$0"
L="${ME%/bin/ccs-nucleus}/etc/ccs/nucleus/lib.sh"
. "$L" || { echo "result $1 failed library"; exit 90; }
ccs_paths
M=nucleus; CODE=CLV-H-CCSNU; NAME="CCS Nucleus"; EXE=/var/lib/hakchi/rootfs/bin/ccs-nucleus
N="$CCSD/nucleus"; REG="$N/registry"; ST="$N/state"; ROOTS="$N/roots"; STAGE="$N/staging"
RUN="$R0/var/ccs-nucleus"   # RAM: hakchi's start stage mounts a RAM folder at /var, and the console keeps it after its system starts
RF="$REG"                   # the registry being read

r(){ echo "result $1 $2"; case "$2" in ok*) exit 0 ;; esac; exit 17; }

# ---------------------------------------------------------------- the registry (ccs-boot-registry/1, DESIGN.md)
opt(){ ccs_get "$RF" "opt.$1.$2"; }
reg(){ ccs_get "$RF" "$1"; }
listed(){ case " $(reg options) " in *" $1 "*) ccs_id_ok "$1" ;; *) return 1 ;; esac; }
image_place_ok(){
  case "$1" in /var/lib/ccs/nucleus/roots/*.hsqs|/var/lib/hakchi/firmware/*.hsqs|/media/hakchi/firmware/*.hsqs) ;; *) return 1 ;; esac
  ccs_path_ok "$1"
}
fw_value_ok(){ case "$1" in auto|_nand_) return 0 ;; esac; ccs_path_ok "$1"; }
# reg_ok [FILE]: sealed, complete and consistent (one native option "native"; every listed option has a kind, a label and what its
# kind needs; the default is listed; a start without the chooser can only begin in the console's own system)
reg_ok(){
  local f="${1:-$REG}" o id k d c n dup
  ccs_sealed "$f" ccs-boot-registry/1 || return 1
  RF="$f"
  ccs_num_ok "$(reg generation)" || return 1
  case "$(reg selection)" in default|last) ;; *) return 1 ;; esac
  c="$(reg chooser)"; case "$c" in always|never) ;; *) return 1 ;; esac
  n="$(reg timeout)"; ccs_num_ok "$n" && [ "$n" -le 99 ] || return 1
  o="$(reg options)"
  dup="$(for id in $o; do echo "$id"; done | sort | uniq -d)"
  [ -z "$dup" ] || return 1
  case " $o " in *" native "*) ;; *) return 1 ;; esac
  for id in $o; do
    ccs_id_ok "$id" || return 1
    k="$(opt "$id" kind)"
    case "$k" in native) [ "$id" = native ] || return 1 ;; ccs-home|owner-root) [ "$id" != native ] || return 1 ;; *) return 1 ;; esac
    ccs_label_ok "$(opt "$id" label)" || return 1
    if [ "$k" = owner-root ]; then
      image_place_ok "$(opt "$id" image)" && ccs_hex64_ok "$(opt "$id" sha256)" && ccs_num_ok "$(opt "$id" bytes)" || return 1
      [ "$(opt "$id" fallback)" = native ] || return 1
    fi
  done
  d="$(reg default)"; listed "$d" || return 1
  [ "$c" = never ] && [ "$(opt "$d" kind)" = owner-root ] && return 1
  return 0
}
# reg_write < body (without its seal): a new registry checked before it is put in force with one rename
reg_write(){
  local cand="$N/registry.candidate.$$"
  mkdir -p "$N" || return 1
  ccs_put_sealed "$cand" || return 1
  reg_ok "$cand" || { rm -f "$cand"; RF="$REG"; return 1; }
  RF="$REG"
  mv -f "$cand" "$REG" || { rm -f "$cand"; return 1; }
  sync
}
reg_body(){ sed '$d' "$REG"; }   # the body of the registry in force (its seal line removed)
# reg_edit AWKPROGRAM: the body changed by an awk program (getting the generation raised), as a new registry
reg_edit(){
  local g
  g="$(reg generation)"; g=$((g + 1))
  reg_body | awk -v gen="$g" "$1"' { if (index($0, "generation=") == 1) { print "generation=" gen; next } print }' | reg_write
}
reg_first(){   # the first registry: the console's own system and CCS HOME
  printf 'schema=ccs-boot-registry/1\ngeneration=1\ndefault=%s\nselection=%s\nchooser=%s\ntimeout=10\noptions=native ccs-home\n' "$1" "$2" "$3"
  printf 'opt.native.kind=native\nopt.native.label=Your Console'"'"'s Own Menu\nopt.native.overlay=hakchi\nopt.native.saves=/var/lib/clover/profiles/0\nopt.native.fallback=-\n'
  printf 'opt.ccs-home.kind=ccs-home\nopt.ccs-home.label=CCS HOME\nopt.ccs-home.package=current\nopt.ccs-home.kernel=3.4.113.29-madmonkey\n'
  printf 'opt.ccs-home.drivers=\nopt.ccs-home.requires=/var/lib/ccs/pkg/current\nopt.ccs-home.overlay=hakchi\nopt.ccs-home.saves=/var/lib/ccs/data\n'
  printf 'opt.ccs-home.compat=nes-usa\nopt.ccs-home.fallback=native\nopt.ccs-home.auto=yes\n'
}

# ---------------------------------------------------------------- state (sealed, on the data storage) and this power-on's record (RAM)
put_state(){ { echo "schema=ccs-nucleus-state/1"; cat; } | ccs_put_sealed "$ST/$1"; }
state_ok(){ ccs_sealed "$ST/$1" ccs-nucleus-state/1; }
st(){ ccs_get "$ST/$1" "$2"; }
note(){   # a line in Nucleus's own log (kept short: the last 100 lines)
  mkdir -p "$ST" 2>/dev/null || return 0
  echo "$*" >> "$ST/log"
  [ "$(wc -l < "$ST/log")" -gt 100 ] && { tail -n 100 "$ST/log" > "$ST/log.new" && mv -f "$ST/log.new" "$ST/log"; }
  return 0
}
mark_failed(){ ccs_id_ok "$1" || return 0; printf 'id=%s\nwhy=%s\n' "$1" "$2" | put_state "failed-$1"; note "failed $1 $2"; }
failed(){ state_ok "failed-$1"; }
clear_failed(){ rm -f "$ST/failed-$1"; }
remember(){ { state_ok last && [ "$(st last id)" = "$1" ]; } || printf 'id=%s\n' "$1" | put_state last; }   # written only when it changes
boot_record(){ mkdir -p "$RUN" 2>/dev/null; printf 'id=%s\nkind=%s\nsrc=%s\nwhy=%s\n' "$1" "$2" "$3" "$4" | ccs_put "$RUN/boot"; }
out(){ echo "ccsn-decision $1 $2 $3 $4 $5"; }

# the option the registry starts by itself: the last one started (selection "last") when it is still listed and did not fail, else the
# default. Only an option in the console's own system ever starts without a choice on the TV (an owner's system image starts only when
# it is chosen, or when the chooser's countdown on the TV ends on it).
policy_pick(){
  local x
  if [ "$(reg selection)" = last ] && state_ok last; then
    x="$(st last id)"
    if listed "$x" && ! failed "$x"; then echo "$x"; return; fi
  fi
  x="$(reg default)"
  if listed "$x" && ! failed "$x"; then echo "$x"; else echo native; fi
}
same_root_pick(){   # the registry's own choice in the console's own system: an owner's image there gives the default, else native
  local x
  x="$(policy_pick)"
  [ "$(opt "$x" kind)" = owner-root ] && x="$(reg default)"
  if [ "$(opt "$x" kind)" = owner-root ] || failed "$x"; then x=native; fi
  echo "$x"
}

# check_root ID: an owner's system image can start now: allowed place, there, its size, a SquashFS image, its SHA-256 (checked in full
# when the file's size or time changed since the last full check), the kernel and drivers it needs, everything it needs from outside
# (USB storage). Sets WHY (one word) when not.
check_root(){
  local id="$1" img sha bytes stamp k d p
  WHY=""
  img="$(opt "$id" image)"; sha="$(opt "$id" sha256)"; bytes="$(opt "$id" bytes)"
  image_place_ok "$img" || { WHY=image-place; return 1; }
  [ -f "$R0$img" ] && [ ! -L "$R0$img" ] || { WHY=image-missing; return 1; }
  [ "$(ccs_size "$R0$img")" = "$bytes" ] || { WHY=image-size; return 1; }
  [ "$(head -c 4 "$R0$img")" = hsqs ] || { WHY=not-a-system-image; return 1; }
  stamp="$sha $bytes $(stat -c %Y "$R0$img" 2>/dev/null)"
  if [ "$(cat "$ST/verified-$id" 2>/dev/null)" != "$stamp" ]; then
    [ "$(ccs_sha "$R0$img")" = "$sha" ] || { WHY=image-changed; return 1; }
    mkdir -p "$ST" && echo "$stamp" | ccs_put "$ST/verified-$id"
  fi
  k="$(opt "$id" kernel)"
  [ -z "$k" ] || [ "$(uname -r)" = "$k" ] || { WHY=kernel; return 1; }
  for d in $(opt "$id" drivers); do
    find "$HKR/lib/modules/$(uname -r)/" -name "$d.ko" 2>/dev/null | grep -q . || { WHY="driver-$d"; return 1; }
  done
  for p in $(opt "$id" requires); do
    ccs_path_ok "$p" && [ -e "$R0$p" ] || { WHY="needs-$p"; return 1; }
  done
  return 0
}

# ---------------------------------------------------------------- the start stage (preinit)
early(){
  local orig="$1" restore="-" id="" kind src a_id a_stage a_orig
  mkdir -p "$RUN" 2>/dev/null
  [ "$(ccs_policy)" = nucleus ] || { out native native - - not-in-charge; return; }
  # 1. an earlier start into an owner's system image that did not reach its start scripts: judged once, here, and never repeated
  if state_ok attempt; then
    a_id="$(st attempt id)"; a_stage="$(st attempt stage)"; a_orig="$(st attempt original)"
    rm -f "$ST/attempt"; sync
    case "$a_stage" in selected) mark_failed "$a_id" not-loaded ;; *) mark_failed "$a_id" did-not-start ;; esac
    # hakchi's own answer to an image it cannot mount (remount_root): it saves cfg_firmware="_nand_" and switches off. The owner's
    # value comes back, so the console's own system starts exactly as the owner had it set.
    if [ "$a_stage" = selected ] && [ "$orig" = _nand_ ] && [ "$a_orig" != _nand_ ] && fw_value_ok "$a_orig"; then restore="$a_orig"; orig="$a_orig"; fi
  elif [ -e "$ST/attempt" ]; then
    rm -f "$ST/attempt"; sync   # an attempt record that was never completely written: nothing was selected with it
  fi
  # 2. a one-time request (the chooser writes it, then restarts the console); used up here, whatever happens next
  if state_ok next; then id="$(st next id)"; src=request; fi
  if [ -e "$ST/next" ]; then rm -f "$ST/next"; sync; fi
  reg_ok || { boot_record native native policy registry-invalid; out native native - "$restore" registry-invalid; return; }
  if [ -n "$id" ] && ! listed "$id"; then note "request-unknown $id"; id=""; fi
  [ -n "$id" ] || { src=policy; id="$(same_root_pick)"; }
  kind="$(opt "$id" kind)"
  if [ "$kind" != owner-root ]; then boot_record "$id" "$kind" "$src" -; out "$kind" "$id" - "$restore" "$src"; return; fi
  if ! check_root "$id"; then
    mark_failed "$id" "$WHY"; boot_record native native "$src" "$id:$WHY"; out native native - "$restore" "$id:$WHY"; return
  fi
  if ! fw_value_ok "$orig"; then
    note "refused $id the-owner-setting-cannot-be-kept"; boot_record native native "$src" "$id:owner-setting"; out native native - "$restore" "$id:owner-setting"; return
  fi
  if ! printf 'id=%s\nstage=selected\noriginal=%s\nimage=%s\n' "$id" "$orig" "$(opt "$id" image)" | put_state attempt; then
    boot_record native native "$src" "$id:state-write"; out native native - "$restore" "$id:state-write"; return
  fi
  note "start $id"
  boot_record "$id" owner-root "$src" -
  out owner-root "$id" "$(opt "$id" image)" "$restore" "$src"
}

# loaded IMAGE: right after hakchi's p7070_firmware. hakchi records a loop file's name in 63 characters, as its own currentFirmware
# allows for (it looks the name up by prefix).
loaded(){
  local fw="$1" id got
  state_ok attempt && [ "$(st attempt image)" = "$fw" ] || return 0
  id="$(st attempt id)"
  got="$(losetup -a 2>/dev/null | awk '{ print $3 }' | while read -r x; do [ ${#x} -ge 20 ] && case "$fw" in "$x"*) echo yes ;; esac; done | head -n 1)"
  if [ "$got" = yes ]; then
    printf 'id=%s\nstage=mounted\noriginal=%s\nimage=%s\n' "$id" "$(st attempt original)" "$fw" | put_state attempt
  else
    rm -f "$ST/attempt"; sync; mark_failed "$id" not-loaded; boot_record native native request "$id:not-loaded"
  fi
}

# ---------------------------------------------------------------- the chooser (on the TV)
# The program: CCS HOME's native HOME program in its chooser mode, from the CCS HOME package pkg/current names (the same pointer checks as
# lib.sh's ccs_home_dir; only the program itself is needed, so a CCS HOME package whose player is missing still shows the chooser, with
# CCS HOME as a choice that cannot start). Sets CH (the program) and CHD (its package folder: the player's menu fonts, the controller codes).
chooser_prog(){
  local P="$CCSD/pkg" V=""
  CH=""; CHD=""
  if [ -f "$P/current" ] && [ ! -L "$P/current" ]; then read -r V < "$P/current"; fi
  case "$V" in ????????????????.????????) ;; *) return 1 ;; esac
  case "$V" in *[!0-9a-f.]*) return 1 ;; esac
  [ -d "$P/$V" ] && [ ! -L "$P/$V" ] && [ -f "$P/$V/home/bin/ccs-home-armv7" ] && [ -x "$P/$V/home/bin/ccs-home-armv7" ] || return 1
  CH="$P/$V/home/bin/ccs-home-armv7"; CHD="$P/$V"
}
# the system running now: "native" (the console's own root, where CCS HOME runs too) or the id of the owner's image this start is in
current_root(){ if [ "$(ccs_get "$RUN/boot" kind)" = owner-root ]; then ccs_get "$RUN/boot" id; else echo native; fi; }
# why_text WHY [IMAGE]: a recorded reason (one word) in plain words for the TV
why_text(){
  case "$1" in
    image-missing) case "$2" in /media/*) echo "Its system image is on USB storage that is not connected." ;; *) echo "Its system image is not on the console." ;; esac ;;
    image-size|image-changed) echo "Its system image changed after it was added." ;;
    image-place|not-a-system-image) echo "Its file is not a system image CCS Nucleus can start." ;;
    kernel) echo "It needs a different kernel than this console runs." ;;
    driver-*) echo "It needs a driver this console does not have." ;;
    needs-/media/*) echo "It needs USB storage that is not connected." ;;
    needs-*) echo "Something it needs is not on the console." ;;
    not-loaded) echo "Its system image could not be opened last time." ;;
    did-not-start) echo "It did not finish starting last time." ;;
    ended-20|not-installed) echo "CCS HOME is not completely installed. Install it again from your computer." ;;
    ended-*) echo "It ended with a problem last time." ;;
    state-write|owner-setting) echo "The console could not prepare the restart." ;;
    *) echo "It cannot start now." ;;
  esac
}
okdefault(){ [ "$(opt "$1" kind)" != owner-root ] || [ "$2" = always ]; }   # ID CHOOSER: may be the default (an owner's image only with the chooser on)
# the rows of Recovery and Settings (each an action this script carries out: act)
settings_rows(){
  local t
  echo "setting=native|Start Your Console's Own Menu"
  echo "setting=clear|Clear Start Problems"
  if [ "$(reg chooser)" = always ]; then echo "setting=show|Show This Screen at Start: On"; else echo "setting=show|Show This Screen at Start: Off"; fi
  if [ "$(reg selection)" = last ]; then echo "setting=start-with|Start With: Last Used"; else echo "setting=start-with|Start With: $(opt "$(reg default)" label)"; fi
  t="$(reg timeout)"; if [ "$t" -eq 0 ]; then echo "setting=countdown|Countdown: Off"; else echo "setting=countdown|Countdown: $t Seconds"; fi
}
# choices MODE HIGHLIGHT AUTO SECONDS NOTICE PANEL: the ccs-choices/1 file the program shows (tools/console-simulator/core/chooser.h). Every
# option is checked again now (an owner's image: place, size, SHA-256, kernel, drivers, USB storage): what cannot start is listed with its
# reason, never left out and never started; what failed before is listed but never started by the countdown.
choices(){
  local cur id k root state why
  cur="$(current_root)"
  printf 'schema=ccs-choices/1\nmode=%s\ntitle=Choose a System\nhighlight=%s\nauto=%s\ntimeout=%s\nnotice=%s\npanel=%s\n' "$1" "$2" "$3" "$4" "$5" "$6"
  for id in $(reg options); do
    k="$(opt "$id" kind)"; state=ok; why=""
    # the same root as the system running now (no restart) or not (the console restarts into it)
    if [ "$cur" = native ]; then case "$k" in owner-root) root=restart ;; *) root=same ;; esac
    elif [ "$id" = "$cur" ]; then root=same; else root=restart; fi
    case "$k" in
      owner-root) if ! check_root "$id"; then state=unavailable; why="$(why_text "$WHY" "$(opt "$id" image)")"
                  elif failed "$id"; then state=retry; why="$(why_text "$(st "failed-$id" why)")"; fi ;;
      ccs-home) if ! ccs_home_dir; then state=unavailable; why="$(why_text not-installed)"
                elif [ "$FAILED_NOW" = ccs-home ]; then state=unavailable; why="It ended with a problem just now. Turn the console off and on to try it again."
                elif failed ccs-home; then state=retry; why="$(why_text "$(st failed-ccs-home why)")"; fi ;;
    esac
    echo "choice=$id|$k|$root|$state|$(opt "$id" label)|$why"
  done
  echo "settings=Recovery and Settings"
  echo "help=If your console does not start the way it should: turn it off, connect it to a computer with its USB cable, hold RESET, switch POWER on and keep holding RESET for about 5 seconds. Then open Console Rescue in the CCS Console Workbench."
  settings_rows
}
# show_chooser MODE HIGHLIGHT AUTO SECONDS NOTICE PANEL: the chooser on the TV until it answers; ANS = its answer line ("" when there is
# none); the program's exit code (15: stopped because the console is shutting down; 1: there is no chooser program). Its pid is kept so
# the console's shutdown (ui-stop) can ask it to end. From the console's menu, hakchi's game-hang watch is fed while it waits, as for a game.
show_chooser(){
  local f="$TMPC/run/choices" a="$TMPC/run/answer" pid rc hb="" map
  ANS=""
  chooser_prog || return 1
  mkdir -p "$TMPC/run" "$TMPC/logs" || return 1
  choices "$@" > "$f" || return 1
  rm -f "$a"
  map="$CHD/config/controller-map.txt"; [ -f "$map" ] || map=""
  "$CH" --choose "$f" --fonts "$CHD/fonts" ${map:+--map "$map"} > "$a" 2>> "$TMPC/logs/chooser.txt" &
  pid=$!
  echo "$pid" > "$TMPC/run/chooser.pid"
  if [ "$1" = menu ]; then ( while kill -0 "$pid" 2>/dev/null; do touch "$R0/tmp/.heartbeat" 2>/dev/null; sleep 1; done ) & hb=$!; fi
  wait "$pid"; rc=$?
  [ -n "$hb" ] && kill "$hb" 2>/dev/null
  rm -f "$TMPC/run/chooser.pid"
  ANS="$(grep -E '^(choice [a-z0-9-]+ [a-z]+|back|action [a-z0-9-]+)$' "$a" 2>/dev/null | tail -n 1)"
  return $rc
}
chooser_stop(){   # the console is shutting down: nothing more starts (the flag, in RAM), and a chooser on the TV is asked to end (it answers nothing)
  local pid n=0
  mkdir -p "$TMPC/run" 2>/dev/null && : > "$TMPC/run/stopping"
  [ -f "$TMPC/run/chooser.pid" ] || return 0
  read -r pid < "$TMPC/run/chooser.pid"
  case "$pid" in ""|*[!0-9]*) return 0 ;; esac
  kill -TERM "$pid" 2>/dev/null || return 0
  while kill -0 "$pid" 2>/dev/null && [ $n -lt 20 ]; do usleep 100000; n=$((n + 1)); done
}
# act KEY: one row of Recovery and Settings, carried out (the registry through "set": a new sealed registry checked before its one rename;
# or Nucleus's own state). Prints the line the chooser shows next.
act(){
  local s d t c id next="" seen=""
  s="$(reg selection)"; d="$(reg default)"; t="$(reg timeout)"; c="$(reg chooser)"
  case "$1" in
    clear)
      rm -f "$ST"/failed-*; sync; FAILED_NOW=""; note "cleared"
      echo "Start problems cleared: a system that did not start before can start by itself again."; return ;;
    show)
      if [ "$c" = always ]; then
        if [ "$(opt "$d" kind)" = owner-root ]; then echo "Your own system images start only from this screen. Change Start With first."; return; fi
        sh "$ME" set chooser never >/dev/null 2>&1 && { echo "This screen no longer shows at start. It still opens when you leave CCS HOME, or from CCS Nucleus in your console's menu."; return; }
      else sh "$ME" set chooser always >/dev/null 2>&1 && { echo "This screen shows at every start."; return; }; fi ;;
    start-with)
      # Last Used, then each option in the order shown (an owner's image only while this screen shows at start), then Last Used again
      for id in $(reg options); do
        if [ "$s" = last ] || [ -n "$seen" ]; then okdefault "$id" "$c" && { next="$id"; break; }; fi
        [ "$id" = "$d" ] && seen=1
      done
      if [ -z "$next" ]; then sh "$ME" set selection last >/dev/null 2>&1 && { echo "Start With: Last Used. The last system chosen starts first."; return; }
      else sh "$ME" set default "$next" >/dev/null 2>&1 && sh "$ME" set selection default >/dev/null 2>&1 && { echo "Start With: $(opt "$next" label)."; return; }; fi ;;
    countdown)
      case "$t" in 5) next=10 ;; 10) next=20 ;; 20) next=30 ;; 30) next=0 ;; *) next=5 ;; esac
      sh "$ME" set timeout "$next" >/dev/null 2>&1 && { if [ "$next" -eq 0 ]; then echo "Countdown: Off. At start this screen waits for a choice."; else echo "Countdown: $next seconds."; fi; return; } ;;
  esac
  echo "That could not be changed. Nothing was changed."
}
# restart_into ID: a one-time request for the next start (the start stage uses it up first), then hakchi's own restart. Used for a
# different root: an owner's image, or from an owner's image back to the console's own system or CCS HOME. Nothing else is started.
restart_into(){
  printf 'id=%s\n' "$1" | put_state next || { mark_failed "$1" state-write; return 1; }
  note "restart-into $1"
  sync
  hakchi reboot
  return 0   # (a restart does not come back)
}

# chooser MODE: boot (the console has just started: S81ccs-nucleus) or menu (the menu entry CCS Nucleus in the console's own menu). Shows the
# chooser on the TV and does what was chosen: the console's own system (boot: its start continues; menu: back to its menu), CCS HOME (then
# the chooser again, as CCS HOME's leave item "Choose Another System" says, also when it is off at start), or a restart into a different
# root. Only the first round at start starts anything by itself (the countdown on the TV, or with the chooser off at start the registry's
# own choice in this system). When CCS HOME ends with a problem at start, the next round counts down to the console's own system (with the
# chooser off at start, that start simply continues), so an unattended console never stays on a problem; every other round waits for a
# choice; at most 60 rounds. A failure always ends in the console's own system.
chooser(){
  local mode="$1" round=0 homes=0 choice="" how="" k rc hl au t notice="" panel=main cur shown="" never fallback=""
  FAILED_NOW=""; SETKEY=""
  [ "$mode" = menu ] && { ccs_screen_free 50 || { ccs_log "nucleus: the screen is still in use"; return 0; }; }
  cur="$(current_root)"
  # a one-time request the chooser made before restarting: what was chosen starts directly
  if [ "$mode" = boot ] && [ "$(ccs_get "$RUN/boot" src)" = request ]; then choice="$(ccs_get "$RUN/boot" id)"; listed "$choice" || choice=""; how=request; fi
  while [ $round -lt 60 ]; do
    round=$((round + 1))
    [ -f "$TMPC/run/stopping" ] && return 0   # the console is shutting down (ui-stop): nothing more starts
    if [ -z "$choice" ]; then
      never=""; [ "$mode" = boot ] && [ "$(reg chooser)" = never ] && [ -z "$shown" ] && never=1
      if [ -n "$never" ] && [ $round -eq 1 ]; then
        choice="$(same_root_pick)"; how=registry   # the chooser is off at start: the registry's own choice in this system
      elif [ -n "$never" ] && [ -n "$fallback" ]; then
        return 0   # CCS HOME started by itself and ended with a problem: the console's own start continues
      else
        hl="$(policy_pick)"; [ "$FAILED_NOW" = "$hl" ] && hl=native
        au=""; t=0
        if [ $round -eq 1 ] && [ "$mode" = boot ]; then t="$(reg timeout)"; au="$hl"
        elif [ -n "$fallback" ]; then t="$(reg timeout)"; au=native; hl=native; fi
        fallback=""
        # what the countdown would start must be able to start now; otherwise the console's own system, and the TV says why
        if [ -n "$au" ] && [ "$(opt "$au" kind)" = owner-root ] && ! check_root "$au"; then notice="$(opt "$au" label) cannot start now. $(why_text "$WHY" "$(opt "$au" image)")"; au=native; hl=native; fi
        [ "$panel" = settings ] && hl="$SETKEY"
        show_chooser "$mode" "$hl" "$au" "$t" "$notice" "$panel"; rc=$?
        notice=""; panel=main; [ -n "$ANS" ] && shown=1   # once it has been on the TV it stays the way back, whatever its setting
        case "$ANS" in
          "choice "*) set -- $ANS; choice="$2"; how="$3"; listed "$choice" || choice="" ;;
          back) return 0 ;;
          "action native") choice=native; how=recovery ;;
          "action "*) set -- $ANS; SETKEY="$2"; notice="$(act "$2")"; [ "$2" = clear ] && FAILED_NOW=""; panel=settings; continue ;;
          *) { [ $rc -eq 15 ] || [ $rc -eq 143 ] || [ -f "$TMPC/run/stopping" ]; } && return 0   # stopped: the console is shutting down, nothing more starts
             # no chooser on the TV (no CCS HOME package with the program, or it gave no answer): at start the registry's own choice
             # in this system, otherwise the console's own system
             if [ $round -eq 1 ] && [ "$mode" = boot ]; then choice="$(same_root_pick)"; [ "$FAILED_NOW" = "$choice" ] && choice=native; else choice=native; fi
             how="no-chooser-$rc" ;;
        esac
        [ -n "$choice" ] || continue
      fi
    fi
    note "chosen $choice $how"
    k="$(opt "$choice" kind)"
    if [ "$cur" != native ]; then   # in an owner's image: its own menu (the same root), or a restart into anything else
      [ "$choice" = "$cur" ] && return 0
      if [ "$k" = owner-root ] && ! check_root "$choice"; then mark_failed "$choice" "$WHY"; notice="$(opt "$choice" label) cannot start now. $(why_text "$WHY" "$(opt "$choice" image)")"; choice=""; continue; fi
      restart_into "$choice" && return 0
      notice="The console could not prepare the restart."; choice=""; continue
    fi
    case "$k" in
      native) [ "$(reg selection)" = last ] && remember native; return 0 ;;
      ccs-home)
        homes=$((homes + 1))
        if [ $homes -eq 1 ] && [ "$mode" = boot ]; then ccs_run_home startup; else ccs_run_home menu; fi
        rc=$?
        if [ $rc -eq 0 ]; then clear_failed ccs-home; [ "$(reg selection)" = last ] && remember ccs-home
        else mark_failed ccs-home "ended-$rc"; FAILED_NOW=ccs-home; notice="CCS HOME ended with a problem."; [ "$mode" = boot ] && fallback=1; fi ;;
      owner-root)
        if check_root "$choice"; then restart_into "$choice" && return 0; notice="The console could not prepare the restart into $(opt "$choice" label)."
        else mark_failed "$choice" "$WHY"; FAILED_NOW="$choice"; notice="$(opt "$choice" label) cannot start now. $(why_text "$WHY" "$(opt "$choice" image)")"; fi ;;
      *) return 0 ;;
    esac
    choice=""; how=""
  done
  return 0
}

# ui-start: this start's record from the start stage. In an owner's system image: it reached its start scripts (the attempt is
# confirmed) and nothing else is done here. Otherwise the chooser, in the console's own system.
ui_start(){
  local id kind
  [ "$(ccs_policy)" = nucleus ] || return 0
  id="$(ccs_get "$RUN/boot" id)"; kind="$(ccs_get "$RUN/boot" kind)"
  if [ "$kind" = owner-root ]; then
    if state_ok attempt && [ "$(st attempt id)" = "$id" ] && [ "$(st attempt stage)" = mounted ]; then
      rm -f "$ST/attempt"; sync; clear_failed "$id"; remember "$id"; note "started $id"
    fi
    return 0
  fi
  reg_ok || return 0
  chooser boot
}

# ---------------------------------------------------------------- management
import(){
  local staged="$1" id="$2" sha="$3" bytes="$4" label="$5" kernel="$6" dest g
  reg_ok || r import "refused the registry is not valid (install one first)"
  ccs_id_ok "$id" && [ "$id" != native ] && [ "$id" != ccs-home ] || r import "refused id"
  ccs_hex64_ok "$sha" && ccs_num_ok "$bytes" && ccs_label_ok "$label" || r import "refused details"
  [ -z "$kernel" ] || ccs_path_ok "/$kernel" || r import "refused kernel"
  dest="/var/lib/ccs/nucleus/roots/$id.hsqs"
  if listed "$id"; then
    [ "$(opt "$id" sha256)" = "$sha" ] && [ "$(opt "$id" image)" = "$dest" ] && [ -f "$R0$dest" ] && rm -f "$R0$staged" && r import "ok already $id"
    r import "refused an option with this id exists"
  fi
  case "$staged" in /var/lib/ccs/nucleus/staging/*) ;; *) r import "refused only an image uploaded to /var/lib/ccs/nucleus/staging/ is imported" ;; esac
  ccs_path_ok "$staged" && [ -f "$R0$staged" ] && [ ! -L "$R0$staged" ] || r import "refused the uploaded image is not there"
  [ "$(ccs_size "$R0$staged")" = "$bytes" ] || r import "refused size"
  [ "$(head -c 4 "$R0$staged")" = hsqs ] || r import "refused not-a-system-image"
  [ "$(ccs_sha "$R0$staged")" = "$sha" ] || r import "refused sha256"
  ccs_own_free "$M" "$dest" "$sha" || r import "refused belongs-to-someone-else $dest"
  mkdir -p "$ROOTS" && ccs_own_add "$M" dir /var/lib/ccs/nucleus/roots || r import "failed folder"
  # one rename on the same data storage: no second copy, nothing else on the console is touched
  mv -f "$R0$staged" "$R0$dest" && sync || r import "failed move"
  [ "$(ccs_size "$R0$dest")" = "$bytes" ] && [ "$(head -c 4 "$R0$dest")" = hsqs ] || r import "failed the moved image is not complete"
  ccs_own_add "$M" data "$dest" || r import "failed journal"
  echo "$sha $bytes $(stat -c %Y "$R0$dest" 2>/dev/null)" | ccs_put "$ST/verified-$id"
  reg_edit '
    index($0, "options=") == 1 { print $0 " '"$id"'"; next }
    index($0, "opt.") == 1 && !done { done = 1
      print "opt.'"$id"'.kind=owner-root"; print "opt.'"$id"'.label='"$label"'"; print "opt.'"$id"'.image='"$dest"'"
      print "opt.'"$id"'.sha256='"$sha"'"; print "opt.'"$id"'.bytes='"$bytes"'"; print "opt.'"$id"'.kernel='"$kernel"'"
      print "opt.'"$id"'.drivers="; print "opt.'"$id"'.requires="; print "opt.'"$id"'.overlay=hakchi"
      print "opt.'"$id"'.saves=/var/lib/clover/profiles/0"; print "opt.'"$id"'.owner=ccs"; print "opt.'"$id"'.fallback=native"
      print "opt.'"$id"'.auto=no" }' || r import "failed registry (the image is kept and recorded; the registry in force is unchanged)"
  r import "ok $id"
}

register_foreign(){
  local p="$1" id="$2" label="$3" sha bytes
  reg_ok || r register-foreign "refused the registry is not valid"
  case "$p" in /var/lib/hakchi/firmware/*.hsqs|/media/hakchi/firmware/*.hsqs) ;; *) r register-foreign "refused only an image in hakchi's firmware folders is referenced" ;; esac
  ccs_path_ok "$p" && ccs_id_ok "$id" && [ "$id" != native ] && [ "$id" != ccs-home ] && ccs_label_ok "$label" || r register-foreign "refused details"
  listed "$id" && r register-foreign "refused an option with this id exists"
  [ -f "$R0$p" ] && [ ! -L "$R0$p" ] && [ "$(head -c 4 "$R0$p")" = hsqs ] || r register-foreign "refused not-a-system-image"
  sha="$(ccs_sha "$R0$p")"; bytes="$(ccs_size "$R0$p")"
  reg_edit '
    index($0, "options=") == 1 { print $0 " '"$id"'"; next }
    index($0, "opt.") == 1 && !done { done = 1
      print "opt.'"$id"'.kind=owner-root"; print "opt.'"$id"'.label='"$label"'"; print "opt.'"$id"'.image='"$p"'"
      print "opt.'"$id"'.sha256='"$sha"'"; print "opt.'"$id"'.bytes='"$bytes"'"; print "opt.'"$id"'.kernel="
      print "opt.'"$id"'.drivers="; print "opt.'"$id"'.requires="; print "opt.'"$id"'.overlay=hakchi"
      print "opt.'"$id"'.saves=/var/lib/clover/profiles/0"; print "opt.'"$id"'.owner=foreign"; print "opt.'"$id"'.fallback=native"
      print "opt.'"$id"'.auto=no" }' || r register-foreign "failed registry"
  r register-foreign "ok $id (referenced, not moved; Nucleus never removes it)"
}

forget(){
  local id="$1"
  reg_ok || r forget "refused the registry is not valid"
  [ "$id" != native ] || r forget "refused the console's own system always stays a choice"
  listed "$id" || r forget "ok not-listed"
  reg_edit '
    index($0, "options=") == 1 { n = split(substr($0, 9), a, " "); s = "options="; sep = ""; for (i = 1; i <= n; i++) if (a[i] != "'"$id"'") { s = s sep a[i]; sep = " " } print s; next }
    index($0, "default='"$id"'") == 1 && length($0) == length("default='"$id"'") { print "default=native"; next }
    index($0, "opt.'"$id"'.") == 1 { next }' || r forget "failed registry"
  rm -f "$ST/failed-$id" "$ST/verified-$id"
  r forget "ok $id (its image file, if any, is kept)"
}

set_value(){
  local k="$1" v="$2"
  reg_ok || r set "refused the registry is not valid"
  case "$k" in
    default) listed "$v" || r set "refused not-listed" ;;
    selection) case "$v" in default|last) ;; *) r set "refused default-or-last" ;; esac ;;
    chooser) case "$v" in always|never) ;; *) r set "refused always-or-never" ;; esac ;;
    timeout) ccs_num_ok "$v" && [ "$v" -le 99 ] || r set "refused 0-to-99" ;;
    *) r set "refused key" ;;
  esac
  reg_edit 'index($0, "'"$k"'=") == 1 { print "'"$k"'='"$v"'"; next }' || r set "refused the result would not be a valid registry (unchanged)"
  r set "ok $k=$v"
}

remove(){
  local how="${1:-keep}"
  case "$how" in keep|remove-data) ;; *) r remove "refused keep-or-remove-data" ;; esac
  # one rename takes Nucleus out of charge: from then on its start stage and start script do nothing, whatever is left
  [ "$(ccs_policy)" = nucleus ] && ccs_policy_set none
  # with remove-data, its own settings go first (the registry and its state: never anyone else's), then its recorded files and data
  [ "$how" = remove-data ] && rm -f "$REG" "$N"/registry.candidate.* "$N"/registry.new.* "$ST"/attempt "$ST"/next "$ST"/last "$ST"/log "$ST"/failed-* "$ST"/verified-* "$ST"/*.new.*
  ccs_own_remove "$M" "$how"
  r remove "ok $how (hakchi's own settings, its firmware folders, other packages, games and saves were not touched)"
}

case "$1" in
  early) early "$2" ;;
  loaded) loaded "$2" ;;
  ui-start) ui_start; exit 0 ;;
  ui-stop) chooser_stop; ccs_home_stop; exit 0 ;;
  choose) [ "$(ccs_policy)" = nucleus ] && reg_ok && chooser menu; exit 0 ;;
  import) import "$2" "$3" "$4" "$5" "$6" "$7" ;;
  register-foreign) register_foreign "$2" "$3" "$4" ;;
  forget) forget "$2" ;;
  set) set_value "$2" "$3" ;;
  registry-install)
    [ -f "$2" ] || r registry-install "failed no file"
    reg_ok "$2" || r registry-install "refused not a valid registry (the one in force is unchanged)"
    g="$(reg generation)"
    if reg_ok; then [ "$g" -gt "$(reg generation)" ] || r registry-install "refused older than the registry in force"; fi
    ccs_put "$REG" < "$2" && reg_ok || r registry-install "failed write"
    r registry-install "ok generation $g" ;;
  preinstall)
    [ -f "$2" ] || r preinstall "failed no file list"
    out="$(ccs_pkg_preflight "$M" "$2")" || { echo "$out"; r preinstall "refused nothing was copied"; }
    ccs_own_free "$M" /var/lib/hakchi/rootfs/etc/ccs/nucleus/FILES "$(ccs_sha "$2")" || r preinstall "refused belongs-to-someone-else /var/lib/hakchi/rootfs/etc/ccs/nucleus/FILES"
    r preinstall ok ;;
  postinstall)
    [ -f "$2" ] || r postinstall "failed no file list"
    pkg="$(ccs_get "$HKR/etc/ccs/nucleus/VERSION" package)"
    ccs_pkg_record "$M" "$2" "${pkg:-unknown}" || r postinstall "failed the copied files are not the package's"
    ccs_own_add "$M" file /var/lib/hakchi/rootfs/etc/ccs/nucleus/FILES || r postinstall "failed journal"
    mkdir -p "$ST" "$STAGE" && ccs_own_add "$M" dir /var/lib/ccs/nucleus && ccs_own_add "$M" dir /var/lib/ccs/nucleus/state && ccs_own_add "$M" dir /var/lib/ccs/nucleus/staging
    reg_ok || reg_first ccs-home last always | reg_write || r postinstall "failed registry"
    out="$(sh "$HKR/bin/ccs-nucleus" entry add 2>&1 | tail -n 1)"
    case "$(ccs_policy)" in "") ccs_policy_set nucleus; now="in-charge" ;; nucleus) now="in-charge" ;; *) now="installed-not-in-charge (CCS Mod is; use take-over)" ;; esac
    r postinstall "ok $now; ${out#result }" ;;
  activate)
    case "$(ccs_policy)" in
      nucleus) r activate "ok already" ;;
      "") reg_ok || r activate "refused the registry is not valid"; ccs_policy_set nucleus || r activate "failed write"; r activate ok ;;
      *) r activate "refused CCS Mod is in charge (use take-over)" ;;
    esac ;;
  take-over)
    # from CCS Mod: games, saves, settings, other packages and system images are not touched. CCS Nucleus's files are already installed
    # (its package). The registry starts as CCS Mod behaved: no chooser on the TV; CCS HOME first when CCS Mod's optional start was on,
    # else straight to the console's own start. One rename puts Nucleus in charge; CCS Mod's own files then go by its own remove.
    ccs_own_valid "$M" || r take-over "refused CCS Nucleus is not installed"
    [ "$(ccs_policy)" = mod ] || r take-over "refused CCS Mod is not in charge"
    first=native
    ccs_sealed "$CCSD/mod/config" ccs-mod-config/1 && [ "$(ccs_get "$CCSD/mod/config" autostart)" = on ] && first=ccs-home
    if reg_ok; then sh "$HKR/bin/ccs-nucleus" set default "$first" >/dev/null 2>&1; sh "$HKR/bin/ccs-nucleus" set chooser never >/dev/null 2>&1
    else reg_first "$first" default never | reg_write || r take-over "failed registry"; fi
    ccs_policy_set nucleus || r take-over "failed write"
    sh "$HKR/bin/ccs-nucleus" entry add >/dev/null 2>&1
    if [ -f "$HKR/bin/ccs-mod" ]; then out="$(sh "$HKR/bin/ccs-mod" remove keep 2>&1 | tail -n 1)"; else out="mod-files-already-gone"; fi
    r take-over "ok in-charge default=$first; ${out#result }" ;;
  remove) remove "$2" ;;
  entry)
    case "$2" in
      add) out="$(ccs_entry_add "$M" "$CODE" "$NAME" "$EXE choose" "$HKR/etc/ccs/nucleus/entry.png")" || r entry "refused ${out##*refused }"
           r entry "ok ${out##*entry }" ;;
      remove) ccs_entry_remove "$M" "$CODE"; r entry "ok removed" ;;
      *) r entry "refused add-or-remove" ;;
    esac ;;
  status)
    echo "policy=$(ccs_policy)"
    if reg_ok; then
      echo "registry generation=$(reg generation) default=$(reg default) selection=$(reg selection) chooser=$(reg chooser) timeout=$(reg timeout)"
      for id in $(reg options); do
        k="$(opt "$id" kind)"; s=ok
        [ "$k" = owner-root ] && { check_root "$id" || s="unavailable $WHY"; }
        failed "$id" && s="$s failed-before:$(st "failed-$id" why)"
        echo "option $id kind=$k $s"
      done
    else echo "registry invalid-or-missing"; fi
    state_ok last && echo "last=$(st last id)"
    [ -f "$RUN/boot" ] && echo "this-start id=$(ccs_get "$RUN/boot" id) kind=$(ccs_get "$RUN/boot" kind) src=$(ccs_get "$RUN/boot" src) why=$(ccs_get "$RUN/boot" why)"
    if ccs_own_valid "$M"; then
      ccs_own_entries "$M" | while read -r line; do
        p="$(ccs_own_path "$line")"
        case "$line" in
          dir=*) [ -d "$R0$p" ] && echo "folder $p" || echo "folder-gone $p" ;;
          data=*) [ -f "$R0$p" ] && echo "data $p" || echo "data-missing $p" ;;
          *) if ccs_own_mine "$M" "$p"; then echo "ok $p"; elif [ -e "$R0$p" ]; then echo "changed $p"; else echo "missing $p"; fi ;;
        esac
      done
    else echo "not-installed"; fi
    r status ok ;;
  *) r "${1:-none}" "refused unknown command" ;;
esac
