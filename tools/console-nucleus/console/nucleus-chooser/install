# CCS Nucleus chooser: installation. hakchi's pack_install sources this file in the package's unpacked folder, with hakchi's own
# functions ($rootfs, $mountpoint, transfer_default). Copyright (C) 2026 Rance9. GPL-3.0-or-later.
# 1. CCS Nucleus itself is installed and every file this package would copy into hakchi's overlay may be written (nothing there, the
#    chooser's own unchanged file, or the same bytes); otherwise nothing is copied, nothing is recorded, and hakchi keeps no uninstall
#    list for it ("no-uninstall")
# 2. hakchi's own transfer_default copies the files, exactly as for any other package
# 3. the copies are checked and recorded (the chooser's ownership journal) and the menu entry is added
# Like other packages that copy their own files, this script then returns 1, so hakchi does not copy them a second time.
ccsnucleuschooser_install(){
  local out
  [ -f "$rootfs/bin/ccs-nucleus" ] || { echo "result install refused CCS Nucleus is not installed (its chooser needs it)"; echo "no-uninstall" >> ./uninstall; return 1; }
  out="$(CCS_ROOT="$mountpoint" sh "$rootfs/bin/ccs-nucleus" chooser-preinstall ./etc/ccs/nucleus-chooser/FILES 2>&1)"
  echo "$out"
  case "$out" in *"result chooser-preinstall ok"*) ;; *) echo "no-uninstall" >> ./uninstall; return 1 ;; esac
  transfer_default || { echo "result install failed copy"; return 1; }
  CCS_ROOT="$mountpoint" sh "$rootfs/bin/ccs-nucleus" chooser-postinstall "$rootfs/etc/ccs/nucleus-chooser/FILES" 2>&1
}
ccsnucleuschooser_install
return 1
