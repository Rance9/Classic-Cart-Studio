#!/bin/sh
# ccs-collections: a Classic Cart Studio collection as ordinary Hakchi games on the console, and the CCS Collection Interface v1 index.
# Copyright (C) 2026 Rance9. GPL-3.0-or-later. BusyBox ash (hakchi 3.9.3's BusyBox 1.29).
#
# The PC (Classic Cart Studio) stages a publication under /var/lib/ccs/integration/stage/ID: a sealed list ("publication", schema
# ccs-hakchi-publication/1: mode, folders, entries and each entry file's SHA-256) and the entry files themselves (files/MENU/CODE/NAME,
# each a game folder in Hakchi's own form: CODE.desktop, CODE.png, CODE_small.png and, only where Hakchi would store its own copy, CODE.nes).
# This program checks it against the console and writes it into the place the console's menu lists games, found with hakchi's own
# findGameStorage (as Hakchi2 CE asks "hakchi findGameStorage", but without running the hakchi command, which also saves hakchi's settings):
#   storage   hakchi's game storage: the first page is its "000" folder (or the storage itself), a folder of the collection is a storage
#             folder ccs-<10 hex> beside hakchi's own, opened by hakchi's chmenu from its folder entry
#   overlay   no game storage: the console menu's own game folder in hakchi's mod folder (rootfs), entries directly there
# A built-in game is a reference to the console's own installed game: its entry is made here from the console's own entry (its game and
# picture paths pointed at hakchi's read-only view of the system, /var/squashfs, its saves in /var/saves), as Hakchi does for its original
# games; nothing of the game is copied.
#
#   where           one line "where mode=storage|overlay menu=DIR store=DIR system=DIR index=SHA|none journal=valid|none"
#   check STAGE     reads only: one line per folder "menu ID free|ours|foreign" and per entry "entry MENU CODE STATE" (free: nothing there;
#                   ours: this program's, unchanged; changed: this program's, but changed since; foreign: someone else's; absent: a
#                   built-in game the console does not have)
#   apply STAGE     the publication written (STAGE/apply, sealed ccs-hakchi-apply/1, names the index and the entries to leave out):
#                   every other entry must still be free or ours; then the journal names old and new files, the files are written,
#                   this program's earlier entries that the publication no longer has are removed while unchanged, the index
#                   /var/lib/ccs/integration/v1/index.json is replaced in one rename (only over the one the PC read: STAGE/apply's
#                   "previous"), and the journal names exactly what is there
#   remove          every file and folder this program wrote that is still unchanged (the index too); changed ones are kept and reported
#   status          what this program wrote, one line each: ok, changed or missing
# Every command ends with one line "result <command> ok ..." or "result <command> failed|refused <why>".
# This program's own record is the ownership journal /var/lib/ccs/owned/published.own (lib.sh, ccs-ownership/1). Something is its own only
# while the journal names it AND its bytes still match. Nothing here writes a kernel, a bootloader, the storage table, the console's own
# system, hakchi's own files or an entry it did not write.
set -f
ME="$0"
L="${ME%/ccs-collections}/lib.sh"
. "$L" || { echo "result $1 failed library"; exit 90; }
ccs_paths
J=published; IDX=/var/lib/ccs/integration/v1/index.json; W="$TMPC/collections.$$"

r(){ rm -rf "$W"; echo "result $1 $2"; case "$2" in ok*) exit 0 ;; esac; exit 17; }
mkdir -p "$W" || { echo "result $1 failed no temporary folder"; exit 17; }

# ---------------------------------------------------------------- where the console's menu lists games
where(){
  MODE=""; MENU=""; STORE=""; GP=""; SQ=""; SYS=""
  local gs
  # hakchi's own functions (its b-files define them; sourcing them runs nothing), in a subshell: the console's software type, region and
  # game folder as hakchi's softwareCheck reads them (b0010_functions lines 298-320; only its reads: it also relinks /var/saves), then
  # hakchi's findGameStorage (lines 371-381), which reads only
  (
    set +f   # hakchi's own functions list folders with patterns (containsGames: ls CLV-*)
    mountpoint="$R0"; temppath="$R0/tmp"
    . "$HKR/etc/preinit" 2>/dev/null && source_base "$HKR/etc/preinit.d" >/dev/null 2>&1 || exit 1
    sftype=""; sfregion=""; gamepath=""
    if [ -d "$squashfs/etc/clover" ]; then
      sftype=nes; sfregion=usa
      [ "$(cat "$squashfs/etc/clover/boardtype" 2>/dev/null)" = dp-shvc ] && sftype=snes
      grep -qF dp-hvcj "$squashfs/etc/issue" 2>/dev/null && sftype=hvcj
      [ "$(cat "$squashfs/etc/clover/REGION" 2>/dev/null)" = JPN ] && sfregion=jpn
      [ "$(cat "$squashfs/etc/clover/REGION" 2>/dev/null)" = EUR ] && sfregion=eur
      if [ "$sftype" = nes ]; then gamepath=/usr/share/games/nes/kachikachi; else gamepath=/usr/share/games; fi
    fi
    echo "gamepath=$gamepath"; echo "squashfs=$squashfs"; echo "store=$(findGameStorage 2>/dev/null)"
  ) > "$W/where" 2>/dev/null || return 1
  GP="$(ccs_get "$W/where" gamepath)"; SQ="$(ccs_get "$W/where" squashfs)"; gs="$(ccs_get "$W/where" store)"
  gs="${gs%/}"; gs="${gs#$R0}"; SQ="${SQ%/}"; SQ="${SQ#$R0}"
  [ -n "$GP" ] && ccs_path_ok "$GP" && [ -n "$SQ" ] && ccs_path_ok "$SQ" || return 1
  SYS="$SQ$GP"
  if [ -n "$gs" ] && ccs_path_ok "$gs" && [ -d "$R0$gs" ] && [ ! -L "$R0$gs" ]; then
    MODE=storage; STORE="$gs"
    if [ -d "$R0$gs/000" ] && [ ! -L "$R0$gs/000" ]; then MENU="$gs/000"; else MENU="$gs"; fi
  else
    MODE=overlay; MENU="/var/lib/hakchi/rootfs$GP"
  fi
  ccs_path_ok "$MENU"
}
menu_dir(){ case "$1" in root) echo "$MENU" ;; *) echo "$STORE/$1" ;; esac; }

# ---------------------------------------------------------------- this program's journal (read once per command)
jload(){ ccs_own_entries "$J" > "$W/journal"; }
jdir(){ grep -qxF "dir=$1" "$W/journal"; }
# jfile PATH: a file= line names PATH with the SHA-256 it has now (the journal may name an old and a new state while a write is under way)
jfile(){
  [ -f "$R0$1" ] && [ ! -L "$R0$1" ] || return 1
  grep -qxF "file=$(ccs_sha "$R0$1") 0644 $1" "$W/journal"
}

# ---------------------------------------------------------------- the staged publication
id_ok(){ case "$1" in root) return 0 ;; ccs-??????????) case "${1#ccs-}" in *[!0-9a-f]*) return 1 ;; esac; return 0 ;; esac; return 1; }
code_ok(){ case "$1" in CLV-[A-Z0-9]-[A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9]) return 0 ;; esac; return 1; }
name_ok(){ case "$2" in "$1.desktop"|"$1.png"|"$1_small.png"|"$1.nes") return 0 ;; esac; return 1; }
# stage STAGE: the publication is sealed, every line well formed, every listed file there with its SHA-256. Sets ST, PUB, PMODE and the
# lists W/menus ("ID PARENT"), W/entries ("KIND MENU CODE"), W/files ("SHA MENU CODE NAME")
stage(){
  local line k a b c d n=0
  ST="$1"
  case "$ST" in /var/lib/ccs/integration/stage/*) ;; *) return 1 ;; esac
  ccs_path_ok "$ST" && [ -d "$R0$ST" ] && [ ! -L "$R0$ST" ] || return 1
  PUB="$R0$ST/publication"
  ccs_sealed "$PUB" ccs-hakchi-publication/1 || return 1
  PMODE=""; : > "$W/menus"; : > "$W/entries"; : > "$W/files"
  sed '1d;$d' "$PUB" > "$W/lines"
  while read -r line; do
    k="${line%%=*}"; set -- ${line#*=}
    case "$k" in
      mode) [ -z "$PMODE" ] && [ $# -eq 1 ] || return 1; case "$1" in storage|overlay) PMODE="$1" ;; *) return 1 ;; esac ;;
      menu) [ $# -eq 2 ] && id_ok "$1" && [ "$1" != root ] && id_ok "$2" || return 1; echo "$1 $2" >> "$W/menus" ;;
      entry) [ $# -eq 3 ] && id_ok "$2" && code_ok "$3" || return 1
             case "$1" in game|folder|back|builtin) ;; *) return 1 ;; esac
             echo "$1 $2 $3" >> "$W/entries" ;;
      file) [ $# -eq 4 ] && ccs_hex64_ok "$1" && id_ok "$2" && code_ok "$3" && name_ok "$3" "$4" || return 1
            a="$R0$ST/files/$2/$3/$4"
            [ -f "$a" ] && [ ! -L "$a" ] && [ "$(ccs_sha "$a")" = "$1" ] || return 1
            grep -qxF "game $2 $3" "$W/entries" || grep -qxF "folder $2 $3" "$W/entries" || grep -qxF "back $2 $3" "$W/entries" || return 1
            echo "$1 $2 $3 $4" >> "$W/files"; n=$((n + 1)) ;;
      *) return 1 ;;
    esac
  done < "$W/lines"
  [ -n "$PMODE" ] || return 1
  # every entry's folder is the first page or a listed folder; the overlay has no folders and no built-in references
  while read -r k a b; do
    [ "$a" = root ] || grep -q "^$a " "$W/menus" || return 1
    [ "$PMODE" = overlay ] && { [ "$a" = root ] && [ "$k" = game ] || return 1; }
  done < "$W/entries"
  return 0
}

# derive CODE OUT: the console's own entry for its built-in game CODE as a Hakchi reference (NesApplication.cs lines 1247-1262 and
# 1314-1320 of Hakchi2 CE 3.9.3): the game and picture paths pointed at hakchi's read-only view of the system, the saves in /var/saves
derive(){
  awk -v p="$GP/$1/" -v sq="$SQ" -v code="$1" '
    { sub(/\r$/, "") }
    /^Exec=/ || /^Icon=/ { k = substr($0, 1, 5); v = substr($0, 6); n = split(v, a, " "); o = ""
      for (i = 1; i <= n; i++) { if (index(a[i], p) == 1) a[i] = sq a[i]; if (i > 1) o = o " "; o = o a[i] }
      print k o; next }
    /^Path=/ { print "Path=/var/saves/" code; next }
    { print }' "$R0$SYS/$1/$1.desktop" > "$2"
}

# state KIND MENU CODE: free | ours | changed | foreign | absent (see check); for a built-in game the derived entry is made in W/derived
state(){
  local d t s
  d="$(menu_dir "$2")/$3"
  if [ "$1" = builtin ]; then
    [ "$PMODE" = storage ] && [ -f "$R0$SYS/$3/$3.desktop" ] && [ ! -L "$R0$SYS/$3/$3.desktop" ] || { echo absent; return; }
    mkdir -p "$W/derived" && derive "$3" "$W/derived/$3.desktop" || { echo absent; return; }
  fi
  # in the overlay, the console's own game folder lies beneath: an entry there with the same code is never covered
  if [ "$MODE" = overlay ] && { [ -e "$R0$SYS/$3" ] || [ -L "$R0$SYS/$3" ]; }; then echo foreign; return; fi
  if [ ! -e "$R0$d" ] && [ ! -L "$R0$d" ]; then echo free; return; fi
  [ -d "$R0$d" ] && [ ! -L "$R0$d" ] && jdir "$d" || { echo foreign; return; }
  # each file the entry writes: not there, this program's unchanged file, or already the new bytes
  if [ "$1" = builtin ]; then
    t="$d/$3.desktop"; s="$(ccs_sha "$W/derived/$3.desktop")"
    if [ -e "$R0$t" ] || [ -L "$R0$t" ]; then jfile "$t" || [ "$(ccs_sha "$R0$t")" = "$s" ] || { echo changed; return; }; fi
  else
    while read -r s a b n; do
      [ "$a" = "$2" ] && [ "$b" = "$3" ] || continue
      t="$d/$n"
      if [ -e "$R0$t" ] || [ -L "$R0$t" ]; then jfile "$t" || { [ -f "$R0$t" ] && [ "$(ccs_sha "$R0$t")" = "$s" ]; } || { echo changed; return; }; fi
    done < "$W/files"
  fi
  echo ours
}
mstate(){   # ID: a collection folder (storage folder) free, ours or foreign
  local d; d="$STORE/$1"
  if [ ! -e "$R0$d" ] && [ ! -L "$R0$d" ]; then echo free; return; fi
  [ -d "$R0$d" ] && [ ! -L "$R0$d" ] && jdir "$d" && echo ours || echo foreign
}

case "$1" in
  where)
    where || r where "failed hakchi's game folders could not be read"
    jload; i=none; [ -f "$R0$IDX" ] && [ ! -L "$R0$IDX" ] && i="$(ccs_sha "$R0$IDX")"
    ccs_own_valid "$J" && j=valid || j=none
    echo "where mode=$MODE menu=$MENU store=${STORE:--} system=$SYS index=$i journal=$j"
    r where ok ;;

  check)
    where || r check "failed hakchi's game folders could not be read"
    stage "$2" || r check "refused the staged publication is not complete or not well formed"
    [ "$PMODE" = "$MODE" ] || r check "refused the console's game folders are not the ones this was prepared for (mode $MODE)"
    jload
    while read -r a b; do echo "menu $a $(mstate "$a")"; done < "$W/menus"
    while read -r k a b; do echo "entry $a $b $(state "$k" "$a" "$b")"; done < "$W/entries"
    r check ok ;;

  apply)
    where || r apply "failed hakchi's game folders could not be read"
    stage "$2" || r apply "refused the staged publication is not complete or not well formed"
    [ "$PMODE" = "$MODE" ] || r apply "refused the console's game folders are not the ones this was prepared for (mode $MODE)"
    A="$R0$ST/apply"
    ccs_sealed "$A" ccs-hakchi-apply/1 || r apply "refused the apply list is missing or not sealed"
    gen="$(ccs_get "$A" generation)"; isha="$(ccs_get "$A" index)"; prev="$(ccs_get "$A" previous)"
    ccs_num_ok "$gen" && ccs_hex64_ok "$isha" || r apply "refused the apply list is not well formed"
    case "$prev" in none) ;; *) ccs_hex64_ok "$prev" || r apply "refused the apply list is not well formed" ;; esac
    [ -f "$R0$ST/index.json" ] && [ ! -L "$R0$ST/index.json" ] && [ "$(ccs_sha "$R0$ST/index.json")" = "$isha" ] || r apply "refused the staged index is not the one listed"
    grep '^skip=' "$A" | sed 's/^skip=//' > "$W/skip"
    while read -r a; do case "$a" in */*) id_ok "${a%%/*}" && code_ok "${a#*/}" || r apply "refused the apply list is not well formed" ;; *) r apply "refused the apply list is not well formed" ;; esac; done < "$W/skip"
    jload
    # 1. everything still as it was checked: the folders free or ours, every entry not left out free or ours, the index the one read
    while read -r a b; do case "$(mstate "$a")" in free|ours) ;; *) r apply "refused changed $STORE/$a is not this program's folder (nothing was changed)" ;; esac; done < "$W/menus"
    : > "$W/go"
    while read -r k a b; do
      grep -qxF "$a/$b" "$W/skip" && continue
      s="$(state "$k" "$a" "$b")"
      case "$s" in free|ours) echo "$k $a $b" >> "$W/go" ;; *) r apply "refused changed $(menu_dir "$a")/$b is $s now (nothing was changed)" ;; esac
    done < "$W/entries"
    cur=none; [ -f "$R0$IDX" ] && [ ! -L "$R0$IDX" ] && cur="$(ccs_sha "$R0$IDX")"
    [ -e "$R0$IDX" ] && [ ! -f "$R0$IDX" ] && r apply "refused $IDX is not a plain file (nothing was changed)"
    [ "$cur" = "$prev" ] || r apply "refused the index changed since it was read (nothing was changed)"
    # 2. what the publication puts there: folders, entry folders and files (with their SHA-256), the index
    : > "$W/new"
    if [ "$MODE" = storage ]; then while read -r a b; do echo "dir=$STORE/$a" >> "$W/new"; done < "$W/menus"; fi
    while read -r k a b; do
      d="$(menu_dir "$a")/$b"; echo "dir=$d" >> "$W/new"
      if [ "$k" = builtin ]; then echo "file=$(ccs_sha "$W/derived/$b.desktop") 0644 $d/$b.desktop" >> "$W/new"
      else grep " $a $b " "$W/files" | while read -r s x y n; do echo "file=$s 0644 $d/$n"; done >> "$W/new"; fi
    done < "$W/go"
    echo "dir=/var/lib/ccs/integration/v1" >> "$W/new"; echo "file=$isha 0644 $IDX" >> "$W/new"
    # without game storage, the console menu's own game folder in hakchi's overlay may not be there yet: the folders missing on the way
    # to it are made (and recorded)
    : > "$W/made"
    if [ "$MODE" = overlay ] && [ ! -d "$R0$MENU" ]; then
      p="$MENU"; while [ -n "$p" ] && [ ! -e "$R0$p" ] && [ ! -L "$R0$p" ]; do echo "$p" >> "$W/made"; p="${p%/*}"; done
      [ -d "$R0$p" ] && [ ! -L "$R0$p" ] || r apply "refused $p is not a folder (nothing was changed)"
      sed 's/^/dir=/' "$W/made" >> "$W/new"
    fi
    sort -u "$W/new" -o "$W/new"
    # 3. the journal names the old state and the new one before anything is written (an interruption leaves only recognized files)
    cat "$W/journal" "$W/new" | ccs_own_write "$J" collections || r apply "failed journal"
    # 4. the folders and files
    sort "$W/made" > "$W/made.sorted"
    while read -r p; do mkdir "$R0$p" || r apply "failed $p"; done < "$W/made.sorted"
    if [ "$MODE" = storage ]; then
      while read -r a b; do [ -d "$R0$STORE/$a" ] || mkdir "$R0$STORE/$a" || r apply "failed $STORE/$a"; done < "$W/menus"
    fi
    wrote=0
    while read -r k a b; do
      d="$(menu_dir "$a")/$b"
      [ -d "$R0$d" ] || mkdir "$R0$d" || r apply "failed $d"
      if [ "$k" = builtin ]; then
        t="$d/$b.desktop"; s="$(ccs_sha "$W/derived/$b.desktop")"
        if [ "$(ccs_sha "$R0$t" 2>/dev/null)" != "$s" ]; then cat "$W/derived/$b.desktop" > "$R0$t.new" && mv -f "$R0$t.new" "$R0$t" || r apply "failed $t"; wrote=$((wrote + 1)); fi
      else
        grep " $a $b " "$W/files" > "$W/ef"
        while read -r s x y n; do
          t="$d/$n"
          if [ "$(ccs_sha "$R0$t" 2>/dev/null)" != "$s" ]; then cat "$R0$ST/files/$a/$b/$n" > "$R0$t.new" && mv -f "$R0$t.new" "$R0$t" || r apply "failed $t"; wrote=$((wrote + 1)); fi
        done < "$W/ef"
      fi
    done < "$W/go"
    sync
    # 5. this program's earlier files and folders the publication no longer has: removed while unchanged; changed ones kept and reported
    sed -n 's/^file=[0-9a-f]* 0644 //p' "$W/new" > "$W/newpaths"
    removed=0; : > "$W/keep"
    while read -r line; do
      case "$line" in
        file=*) p="${line##* }"; s="${line#file=}"; s="${s%% *}"
          grep -qxF "$p" "$W/newpaths" && continue
          if [ ! -e "$R0$p" ] && [ ! -L "$R0$p" ]; then :
          elif [ -f "$R0$p" ] && [ ! -L "$R0$p" ] && [ "$(ccs_sha "$R0$p")" = "$s" ]; then rm -f "$R0$p" && removed=$((removed + 1)); echo "removed $p"
          elif grep -q "^file=[0-9a-f]* 0644 $p\$" "$W/journal" && jfile "$p"; then :   # another state the journal names (removed by its own line)
          else echo "kept-changed $p"; echo "$line" >> "$W/keep"; fi ;;
      esac
    done < "$W/journal"
    grep '^dir=' "$W/journal" | sed 's/^dir=//' | sort -r > "$W/dirs"
    while read -r p; do
      grep -qxF "dir=$p" "$W/new" && continue
      if [ -d "$R0$p" ] && [ ! -L "$R0$p" ]; then
        set +f; rm -f "$R0$p"/*.new 2>/dev/null; set -f   # a write cut short leaves NAME.new beside its file
        if rmdir "$R0$p" 2>/dev/null; then echo "removed $p/"; else echo "kept-folder $p/"; echo "dir=$p" >> "$W/keep"; fi
      fi
    done < "$W/dirs"
    # 6. the index, in one rename (written, synced, renamed)
    mkdir -p "$R0/var/lib/ccs/integration/v1" && ccs_put "$R0$IDX" < "$R0$ST/index.json" && [ "$(ccs_sha "$R0$IDX")" = "$isha" ] || r apply "failed index"
    # 7. the journal names exactly what is there now
    cat "$W/new" "$W/keep" | ccs_own_write "$J" collections || r apply "failed journal"
    r apply "ok entries=$(wc -l < "$W/go" | tr -d ' ') wrote=$wrote removed=$removed generation=$gen" ;;

  remove)
    ccs_own_remove "$J" keep
    r remove ok ;;

  status)
    jload
    ok=0; ch=0; mi=0
    sed -n 's/^file=[0-9a-f]* 0644 //p' "$W/journal" | sort -u > "$W/paths"
    while read -r p; do
      if jfile "$p"; then echo "ok $p"; ok=$((ok + 1))
      elif [ -e "$R0$p" ] || [ -L "$R0$p" ]; then echo "changed $p"; ch=$((ch + 1))
      else echo "missing $p"; mi=$((mi + 1)); fi
    done < "$W/paths"
    ccs_own_valid "$J" && j=valid || j=none
    i=none; [ -f "$R0$IDX" ] && [ ! -L "$R0$IDX" ] && i="$(ccs_sha "$R0$IDX")"
    r status "ok journal=$j files=$ok changed=$ch missing=$mi index=$i" ;;

  *) r "${1:-none}" "refused unknown command" ;;
esac
