# CCS Mod removes only its own files that are still unchanged (its ownership journal); a changed one is kept and reported. Its settings
# and CCS HOME's package and saves are kept. The list hakchi appends below this line removes every file the package carried whether
# or not someone changed it since, so it is never reached: this script returns first.
[ -f "$rootfs/bin/ccs-mod" ] && CCS_ROOT="$mountpoint" sh "$rootfs/bin/ccs-mod" remove keep
return 0
