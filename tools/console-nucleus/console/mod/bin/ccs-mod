#!/bin/sh
# ccs-mod: CCS Mod for Hakchi on the console, the ONLY provider of CCS HOME: a CCS HOME tile in Original Menu
# (Nintendo's own menu) opens it; leaving it goes to CCS Nucleus's chooser when that is installed, otherwise back to Original Menu. CCS Mod
# has no power-on, preinit, service or restart action: what opens at power-on is CCS Nucleus's setting, never CCS Mod's.
# Copyright (C) 2026 Rance9. GPL-3.0-or-later. BusyBox ash (hakchi 3.9.3's BusyBox 1.29).
#
#   launch               the tile: CCS HOME once the console's menu has handed over the screen. Leaving it ("Choose Another Menu"):
#                        CCS Nucleus's chooser when its chooser is installed, else back to Original Menu
#   entry add|remove     the tile "CCS HOME" (CLV-H-CCSMD in the menu folder hakchi's findGameStorage names)
#   preinstall FILES     (the package's install script, before hakchi copies anything) every file the package would copy may be
#                        written: nothing there, or this method's own unchanged file, or already the same bytes
#   postinstall FILES    (the package's install script, after hakchi's transfer_default) the copies checked, the journal written, the
#                        tile added
#   remove [keep|remove-data]   CCS Mod's unchanged files removed (changed ones kept and reported); not CCS HOME's package or saves
#   status               what is there, one line each
# Every command ends with one line "result <command> ok ..." or "result <command> failed|refused <why>".
# Nothing here writes a kernel, a bootloader, the storage table or the console's own system image: only files on its data storage
# (hakchi's overlay, hakchi's game storage, /var/lib/ccs).
ME="$0"
L="${ME%/bin/ccs-mod}/etc/ccs/mod/lib.sh"
. "$L" || { echo "result $1 failed library"; exit 90; }
ccs_paths
M=mod; CODE=CLV-H-CCSMD; NAME="CCS HOME"; EXE=/var/lib/hakchi/rootfs/bin/ccs-mod

r(){ echo "result $1 $2"; case "$2" in ok*) exit 0 ;; esac; exit 17; }

case "$1" in
  launch)
    # chosen in Original Menu: that menu hands over the screen when it starts an entry; nothing is stopped by force
    ccs_screen_free 50 || { ccs_log "mod: the screen is still in use; CCS HOME was not opened"; r launch "ok screen-busy (back to Original Menu)"; }
    ccs_run_home menu; rc=$?
    [ $rc -eq 0 ] || ccs_log "mod: CCS HOME ended with $rc"
    # Choose Another Menu: CCS Nucleus's chooser when it is installed with its chooser; otherwise Original Menu
    if [ $rc -eq 0 ] && ccs_chooser_installed; then sh "$HKR/bin/ccs-nucleus" choose >/dev/null 2>&1; r launch "ok home-ended 0 (to the chooser)"; fi
    r launch "ok home-ended $rc (back to Original Menu)" ;;

  entry)
    case "$2" in
      add) out="$(ccs_entry_add "$M" "$CODE" "$NAME" "$EXE launch" "$HKR/etc/ccs/mod/entry.png")" || r entry "refused ${out##*refused }"
           r entry "ok ${out##*entry }" ;;
      remove) ccs_entry_remove "$M" "$CODE"; r entry "ok removed" ;;
      *) r entry "refused add-or-remove" ;;
    esac ;;

  preinstall)
    [ -f "$2" ] || r preinstall "failed no file list"
    out="$(ccs_pkg_preflight "$M" "$2")" || { echo "$out"; r preinstall "refused nothing was copied"; }
    ccs_own_free "$M" /var/lib/hakchi/rootfs/etc/ccs/mod/FILES "$(ccs_sha "$2")" || r preinstall "refused belongs-to-someone-else /var/lib/hakchi/rootfs/etc/ccs/mod/FILES"
    r preinstall ok ;;

  postinstall)
    [ -f "$2" ] || r postinstall "failed no file list"
    pkg="$(ccs_get "$HKR/etc/ccs/mod/VERSION" package)"
    ccs_pkg_record "$M" "$2" "${pkg:-unknown}" || r postinstall "failed the copied files are not the package's"
    ccs_own_add "$M" file /var/lib/hakchi/rootfs/etc/ccs/mod/FILES || r postinstall "failed journal"
    out="$(sh "$HKR/bin/ccs-mod" entry add 2>&1 | tail -n 1)"
    r postinstall "ok installed; ${out#result }" ;;

  remove)
    how="${2:-keep}"; case "$how" in keep|remove-data) ;; *) r remove "refused keep-or-remove-data" ;; esac
    ccs_own_remove "$M" "$how"
    r remove "ok $how (CCS HOME's package and saves are kept: they are shared, and removed only by removing CCS HOME itself)" ;;

  status)
    if ccs_own_valid "$M"; then
      echo "package=$(ccs_get "$(ccs_own_file "$M")" package)"
      ccs_own_entries "$M" | while read -r line; do
        p="$(ccs_own_path "$line")"
        case "$line" in
          dir=*) [ -d "$R0$p" ] && echo "folder $p" || echo "folder-gone $p" ;;
          *) if ccs_own_mine "$M" "$p"; then echo "ok $p"; elif [ -e "$R0$p" ]; then echo "changed $p"; else echo "missing $p"; fi ;;
        esac
      done
    else echo "not-installed"; fi
    ccs_chooser_installed && echo "chooser=installed" || echo "chooser=none"
    ccs_home_dir && echo "home=${HOME_DIR#$R0}" || echo "home=none"
    r status ok ;;

  *) r "${1:-none}" "refused unknown command" ;;
esac
